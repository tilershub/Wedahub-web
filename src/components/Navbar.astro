---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/professionals', label: 'Find Pros' },
  { href: '/projects', label: 'Projects' },
  { href: '/post', label: 'Get Quotes' },
];

const currentPath = Astro.url.pathname;
const isActivePath = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<nav class="fixed top-0 z-50 w-full border-b border-stone-200 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-3 py-2 sm:px-6 sm:py-3 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 text-base font-bold text-white sm:h-9 sm:w-9 sm:text-lg">
        W
      </div>
      <span class="text-lg font-bold text-stone-900 sm:text-xl">
        වැඩ<span class="text-brand-600">HUB</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium transition-colors',
            isActivePath(link.href)
              ? 'text-brand-600'
              : 'text-stone-600 hover:text-brand-600',
          ]}
          aria-current={isActivePath(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Auth Buttons moved to hamburger menu -->
    <div id="nav-guest" class="hidden"></div>

    <!-- User Menu (shown when logged in) -->
    <div id="nav-user" class="hidden items-center gap-3 md:flex">
      <!-- Pro dropdown (only for professionals) -->
      <div id="nav-pro-menu" class="relative hidden">
        <button id="pro-menu-btn" class="flex items-center gap-1 rounded-lg border border-brand-200 bg-brand-50 px-3 py-1.5 text-sm font-medium text-brand-700 hover:bg-brand-100">
          Pro Tools
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="pro-dropdown" class="absolute right-0 mt-2 hidden w-52 rounded-xl border border-stone-200 bg-white py-2 shadow-lg">
          <a href="/pro/profile" class="flex items-center gap-2 px-4 py-2 text-sm text-stone-700 hover:bg-stone-50">
            <span class="text-base">⚙️</span> Business Profile
          </a>
          <a href="/pro/add-project" class="flex items-center gap-2 px-4 py-2 text-sm text-stone-700 hover:bg-stone-50">
            <span class="text-base">📸</span> Add Project
          </a>
          <a href="/pro/projects" class="flex items-center gap-2 px-4 py-2 text-sm text-stone-700 hover:bg-stone-50">
            <span class="text-base">📂</span> My Projects
          </a>
          <hr class="my-1 border-stone-100" />
          <a href="/projects" class="flex items-center gap-2 px-4 py-2 text-sm text-stone-700 hover:bg-stone-50">
            <span class="text-base">📋</span> Browse Requests
          </a>
        </div>
      </div>
      <a href="/dashboard" class="btn-secondary text-sm">Dashboard</a>
      <button id="logout-btn" class="rounded-lg px-3 py-1.5 text-sm font-medium text-stone-500 hover:bg-stone-100 hover:text-stone-700">Log Out</button>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="flex h-10 w-10 items-center justify-center rounded-lg text-stone-600 hover:bg-stone-100"
      aria-label="Toggle menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-stone-200 bg-white/95">
    <div class="max-h-[calc(100vh-4rem)] space-y-1 overflow-y-auto px-3 py-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block rounded-lg px-3 py-2.5 text-sm font-medium active:bg-stone-200',
            isActivePath(link.href)
              ? 'bg-brand-50 text-brand-600'
              : 'text-stone-600 hover:bg-stone-100 hover:text-brand-600',
          ]}
          aria-current={isActivePath(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <!-- Mobile Pro Links (hidden by default, shown for professionals) -->
      <div id="mobile-pro-links" class="hidden">
        <hr class="my-2 border-stone-200" />
        <div class="px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-stone-400">Pro Tools</div>
        <a href="/pro/profile" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-brand-600 hover:bg-brand-50 active:bg-brand-100">Business Profile</a>
        <a href="/pro/add-project" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-brand-600 hover:bg-brand-50 active:bg-brand-100">Add Project</a>
        <a href="/pro/projects" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-brand-600 hover:bg-brand-50 active:bg-brand-100">My Projects</a>
      </div>

      <hr class="my-2 border-stone-200" />

      <!-- Mobile Guest -->
      <div id="mobile-guest">
        <a href="/login" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-stone-600 hover:bg-stone-100 active:bg-stone-200">
          Log In
        </a>
        <a href="/register" class="mt-2 block rounded-lg bg-brand-600 px-3 py-2.5 text-center text-sm font-medium text-white active:bg-brand-700">
          Join as Pro
        </a>
      </div>

      <!-- Mobile User -->
      <div id="mobile-user" class="hidden">
        <a href="/dashboard" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-stone-600 hover:bg-stone-100 active:bg-stone-200">
          Dashboard
        </a>
        <button id="mobile-logout-btn" class="mt-1 w-full rounded-lg px-3 py-2.5 text-left text-sm font-medium text-red-500 hover:bg-red-50 active:bg-red-100">
          Log Out
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  let supabaseClient: any = null;

  async function getSupabaseClient() {
    if (supabaseClient) return supabaseClient;

    try {
      const { supabase } = await import('../lib/supabase');
      supabaseClient = supabase;
      return supabaseClient;
    } catch (error) {
      console.warn('Supabase client is not available in navbar script.', error);
      return null;
    }
  }

  const navElements = {
    mobileMenuBtn: document.getElementById('mobile-menu-btn'),
    mobileMenu: document.getElementById('mobile-menu'),
    navGuest: document.getElementById('nav-guest'),
    navUser: document.getElementById('nav-user'),
    navProMenu: document.getElementById('nav-pro-menu'),
    mobileGuest: document.getElementById('mobile-guest'),
    mobileUser: document.getElementById('mobile-user'),
    mobileProLinks: document.getElementById('mobile-pro-links'),
    logoutBtn: document.getElementById('logout-btn'),
    mobileLogoutBtn: document.getElementById('mobile-logout-btn'),
  };

  function isMobileMenuOpen() {
    return navElements.mobileMenu && !navElements.mobileMenu.classList.contains('hidden');
  }

  function toggleMobileMenu(forceOpen?: boolean) {
    if (!navElements.mobileMenu || !navElements.mobileMenuBtn) return;

    const shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : !isMobileMenuOpen();
    navElements.mobileMenu.classList.toggle('hidden', !shouldOpen);
    navElements.mobileMenuBtn.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
  }

  // Pro dropdown toggle
  const proMenuBtn = document.getElementById('pro-menu-btn');
  const proDropdown = document.getElementById('pro-dropdown');

  navElements.mobileMenuBtn?.addEventListener('click', () => {
    toggleMobileMenu();
  });

  navElements.mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => toggleMobileMenu(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      toggleMobileMenu(false);
      proDropdown?.classList.add('hidden');
    }
  });

  proMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    proDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    proDropdown?.classList.add('hidden');
  });

  // Auth state
  async function initNav() {
    const supabase = await getSupabaseClient();

    if (!supabase) {
      return;
    }

    const { data: { user } } = await supabase.auth.getUser();

    if (user) {
      const isPro = user.user_metadata?.role === 'professional';

      // Desktop
      navElements.navUser?.classList.remove('hidden');
      navElements.navUser?.classList.add('flex');

      if (isPro) {
        navElements.navProMenu?.classList.remove('hidden');
        navElements.mobileProLinks?.classList.remove('hidden');
      }

      // Mobile
      navElements.mobileGuest?.classList.add('hidden');
      navElements.mobileUser?.classList.remove('hidden');
    } else {
      navElements.navUser?.classList.add('hidden');
      navElements.navUser?.classList.remove('flex');
    }
  }

  // Logout handlers
  async function logout() {
    const supabase = await getSupabaseClient();

    if (!supabase) {
      window.location.href = '/';
      return;
    }

    await supabase.auth.signOut();
    window.location.href = '/';
  }

  navElements.logoutBtn?.addEventListener('click', logout);
  navElements.mobileLogoutBtn?.addEventListener('click', logout);

  initNav();
</script>
