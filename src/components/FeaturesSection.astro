---
const features = [
  {
    icon: '🏗️',
    title: 'Verified Professionals',
    description: 'Every contractor, architect, and tradesperson is verified with license checks, portfolio reviews, and identity verification.',
  },
  {
    icon: '📸',
    title: 'Project Portfolios',
    description: 'Browse real photos of completed projects — kitchens, bathrooms, new builds, renovations — to find the right style.',
  },
  {
    icon: '💰',
    title: 'Free Quotes',
    description: 'Describe your project and receive competitive quotes from multiple professionals. Compare and choose the best fit.',
  },
  {
    icon: '🔒',
    title: 'Secure Payments',
    description: 'Milestone-based payments protect both homeowners and contractors. Pay only when work meets your standards.',
  },
  {
    icon: '⭐',
    title: 'Ratings & Reviews',
    description: 'Read honest reviews from real homeowners. Every completed project generates verified ratings you can trust.',
  },
  {
    icon: '🇱🇰',
    title: 'All Across Sri Lanka',
    description: 'From Colombo to Kandy, Galle to Jaffna — find trusted construction professionals near you, islandwide.',
  },
];
---

<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        The Smarter Way to Build & Renovate
      </h2>
      <p class="mt-4 text-lg text-gray-500">
        Whether you're building new or renovating, වැඩHUB connects you with the right professionals.
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <div class="card group">
          <div class="mb-4 text-3xl">{feature.icon}</div>
          <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600">
            {feature.title}
          </h3>
          <p class="mt-2 text-sm text-gray-500">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
