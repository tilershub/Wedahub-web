---
const categories = [
  { name: 'General Contractors', count: 520, icon: '🏗️' },
  { name: 'Architects', count: 185, icon: '📐' },
  { name: 'Interior Designers', count: 240, icon: '🛋️' },
  { name: 'Plumbing', count: 380, icon: '🔧' },
  { name: 'Electrical Work', count: 410, icon: '⚡' },
  { name: 'Masonry', count: 210, icon: '🧱' },
  { name: 'Tiling', count: 180, icon: '⬜' },
  { name: 'Carpentry', count: 215, icon: '🪚' },
  { name: 'Painting', count: 340, icon: '🎨' },
  { name: 'Roofing', count: 165, icon: '🏠' },
  { name: 'Landscaping', count: 130, icon: '🌿' },
  { name: 'Glass Work', count: 95, icon: '🪟' },
  { name: 'Ceiling', count: 120, icon: '🏢' },
  { name: 'Pantry Cupboards', count: 110, icon: '🗄️' },
  { name: 'Welding & Metalwork', count: 175, icon: '🔩' },
  { name: 'Waterproofing', count: 95, icon: '💧' },
];
---

<section class="bg-gray-50 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Browse by Service
      </h2>
      <p class="mt-4 text-lg text-gray-500">
        Find the right professional for every aspect of your construction or renovation project.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {categories.map((category) => (
        <a
          href={`/professionals?service=${encodeURIComponent(category.name)}`}
          class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-5 transition-all hover:border-brand-300 hover:shadow-md"
        >
          <span class="text-2xl">{category.icon}</span>
          <div>
            <div class="font-semibold text-gray-900">{category.name}</div>
            <div class="text-sm text-gray-400">{category.count} pros</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
