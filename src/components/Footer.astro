---
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'Platform',
    links: [
      { href: '/gigs', label: 'Find Work' },
      { href: '/post', label: 'Post a Job' },
      { href: '/categories', label: 'Categories' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About Us' },
      { href: '/contact', label: 'Contact' },
      { href: '/blog', label: 'Blog' },
    ],
  },
  {
    title: 'Support',
    links: [
      { href: '/help', label: 'Help Center' },
      { href: '/terms', label: 'Terms of Service' },
      { href: '/privacy', label: 'Privacy Policy' },
    ],
  },
];
---

<footer class="border-t border-gray-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-lg font-bold text-white">
            W
          </div>
          <span class="text-xl font-bold text-gray-900">
            වැඩ<span class="text-brand-600">HUB</span>
          </span>
        </a>
        <p class="mt-3 text-sm text-gray-500">
          Sri Lanka's premier freelance platform. Connect with skilled professionals and find quality work.
        </p>
      </div>

      {footerSections.map((section) => (
        <div>
          <h3 class="text-sm font-semibold text-gray-900">{section.title}</h3>
          <ul class="mt-3 space-y-2">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-gray-500 transition-colors hover:text-brand-600"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 border-t border-gray-200 pt-6 text-center text-sm text-gray-400">
      &copy; {currentYear} වැඩHUB. All rights reserved.
    </div>
  </div>
</footer>
