---
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'For Homeowners',
    links: [
      { href: '/professionals', label: 'Find Professionals' },
      { href: '/post', label: 'Get Free Quotes' },
      { href: '/projects', label: 'Browse Projects' },
      { href: '/ideas', label: 'Design Ideas' },
    ],
  },
  {
    title: 'For Professionals',
    links: [
      { href: '/register', label: 'Join as a Pro' },
      { href: '/pro-resources', label: 'Pro Resources' },
      { href: '/pricing', label: 'Pricing' },
      { href: '/success-stories', label: 'Success Stories' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About Us' },
      { href: '/contact', label: 'Contact' },
      { href: '/terms', label: 'Terms of Service' },
      { href: '/privacy', label: 'Privacy Policy' },
    ],
  },
];
---

<footer class="border-t border-gray-200 bg-gray-900">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-6 sm:gap-8 md:grid-cols-4">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-500 text-lg font-bold text-white">
            W
          </div>
          <span class="text-xl font-bold text-white">
            වැඩ<span class="text-brand-400">HUB</span>
          </span>
        </a>
        <p class="mt-3 text-sm text-gray-400">
          Sri Lanka's trusted platform for finding construction professionals, home improvement experts, and building service providers.
        </p>
      </div>

      {footerSections.map((section) => (
        <div>
          <h3 class="text-sm font-semibold text-white">{section.title}</h3>
          <ul class="mt-3 space-y-2">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-gray-400 transition-colors hover:text-brand-400"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 border-t border-gray-800 pt-6 text-center text-sm text-gray-500">
      &copy; {currentYear} වැඩHUB. All rights reserved. Built for Sri Lanka.
    </div>
  </div>
</footer>
