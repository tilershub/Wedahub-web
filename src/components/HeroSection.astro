---
const serviceTypes = [
  'General Contractor',
  'Architect',
  'Plumber',
  'Electrician',
  'Interior Designer',
  'Mason',
  'Carpenter',
  'Painter',
  'Landscaper',
];
---

<section class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-brand-950 to-gray-900">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-6 inline-flex rounded-full bg-brand-500/20 px-4 py-1.5 text-sm font-medium text-brand-300">
        Sri Lanka's #1 Construction Services Platform
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Build Your Dream Home
        <span class="block text-brand-400">with Trusted Pros</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-gray-300">
        Find verified construction professionals, architects, and home improvement experts across Sri Lanka. Get free quotes and hire with confidence.
      </p>

      <!-- Search Bar -->
      <div class="mx-auto mt-10 max-w-2xl">
        <div class="flex flex-col gap-3 rounded-2xl bg-white p-3 shadow-2xl sm:flex-row">
          <select class="flex-1 rounded-xl border-0 bg-gray-50 px-4 py-3.5 text-sm text-gray-900 focus:ring-2 focus:ring-brand-500">
            <option value="">What service do you need?</option>
            {serviceTypes.map((service) => (
              <option value={service}>{service}</option>
            ))}
          </select>
          <input
            type="text"
            placeholder="City or area (e.g. Colombo)"
            class="flex-1 rounded-xl border-0 bg-gray-50 px-4 py-3.5 text-sm text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-500"
          />
          <a href="/professionals" class="rounded-xl bg-brand-600 px-8 py-3.5 text-center text-sm font-semibold text-white transition-colors hover:bg-brand-700">
            Search
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="mt-16 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div>
          <div class="text-3xl font-bold text-white sm:text-4xl">3,500+</div>
          <div class="mt-1 text-sm text-gray-400">Verified Pros</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-white sm:text-4xl">12K+</div>
          <div class="mt-1 text-sm text-gray-400">Projects Done</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-white sm:text-4xl">25+</div>
          <div class="mt-1 text-sm text-gray-400">Districts</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-white sm:text-4xl">4.8</div>
          <div class="mt-1 text-sm text-gray-400">Avg Rating</div>
        </div>
      </div>
    </div>
  </div>
</section>
