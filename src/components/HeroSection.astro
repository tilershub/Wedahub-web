---
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-600 via-brand-700 to-brand-900">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Find the Right
        <span class="block text-brand-200">වැඩ (Work)</span>
        <span class="block">Right Here</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-brand-100">
        Sri Lanka's premier freelance platform. Connect with skilled professionals,
        post projects, and get work done — all in one place.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/gigs" class="w-full rounded-xl bg-white px-8 py-4 text-base font-semibold text-brand-700 shadow-lg transition-transform hover:scale-105 hover:shadow-xl sm:w-auto">
          Browse Jobs
        </a>
        <a href="/register" class="w-full rounded-xl border-2 border-white/30 px-8 py-4 text-base font-semibold text-white backdrop-blur-sm transition-transform hover:scale-105 hover:bg-white/10 sm:w-auto">
          Start Freelancing
        </a>
      </div>

      <!-- Stats -->
      <div class="mt-16 grid grid-cols-3 gap-6">
        <div>
          <div class="text-3xl font-bold text-white sm:text-4xl">5K+</div>
          <div class="mt-1 text-sm text-brand-200">Freelancers</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-white sm:text-4xl">2K+</div>
          <div class="mt-1 text-sm text-brand-200">Projects</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-white sm:text-4xl">98%</div>
          <div class="mt-1 text-sm text-brand-200">Satisfaction</div>
        </div>
      </div>
    </div>
  </div>
</section>
