---
---

<section class="bg-brand-900 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-8">
      <!-- For Homeowners -->
      <div class="rounded-2xl bg-white/10 p-8 backdrop-blur-sm">
        <div class="mb-4 text-3xl">🏡</div>
        <h3 class="text-2xl font-bold text-white">For Homeowners</h3>
        <p class="mt-3 text-brand-200">
          Planning a new build, renovation, or repair? Post your project for free and receive quotes from verified professionals in your area.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-brand-100">
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-brand-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Free to post projects
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-brand-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Get multiple quotes to compare
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-brand-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Secure milestone payments
          </li>
        </ul>
        <a href="/post" class="mt-6 inline-block rounded-xl bg-white px-8 py-3 text-sm font-semibold text-brand-700 transition-colors hover:bg-gray-100">
          Post Your Project
        </a>
      </div>

      <!-- For Professionals -->
      <div class="rounded-2xl bg-white/10 p-8 backdrop-blur-sm">
        <div class="mb-4 text-3xl">🔨</div>
        <h3 class="text-2xl font-bold text-white">For Professionals</h3>
        <p class="mt-3 text-brand-200">
          Grow your construction business by connecting with homeowners who need your services. Build your reputation and win more projects.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-brand-100">
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-brand-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Showcase your portfolio
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-brand-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Receive project leads directly
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-brand-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Guaranteed secure payments
          </li>
        </ul>
        <a href="/register" class="mt-6 inline-block rounded-xl bg-brand-500 px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-600">
          Join as a Pro
        </a>
      </div>
    </div>
  </div>
</section>
