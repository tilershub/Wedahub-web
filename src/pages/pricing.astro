---
import BaseLayout from '../layouts/BaseLayout.astro';

const plans = [
  {
    name: 'Homeowner',
    price: 'Free',
    period: 'Forever',
    description: 'Everything you need to find and hire construction professionals',
    features: [
      'Post unlimited project requests',
      'Receive quotes from professionals',
      'Browse professional profiles & projects',
      'Message professionals directly',
      'Leave reviews & ratings',
      'Access to all service categories',
    ],
    cta: 'Get Started Free',
    href: '/register',
    highlighted: false,
  },
  {
    name: 'Pro Basic',
    price: 'LKR 2,500',
    period: '/month',
    description: 'For individual contractors and tradespeople getting started',
    features: [
      'Business profile listing',
      'Showcase up to 10 projects',
      'Receive project leads',
      'Send up to 20 quotes/month',
      'Customer reviews & ratings',
      'Basic analytics dashboard',
    ],
    cta: 'Start Free Trial',
    href: '/register',
    highlighted: false,
  },
  {
    name: 'Pro Plus',
    price: 'LKR 7,500',
    period: '/month',
    description: 'For growing businesses that want maximum visibility and leads',
    features: [
      'Everything in Pro Basic',
      'Unlimited project showcase',
      'Unlimited quotes per month',
      'Priority listing in search results',
      'Verified badge on profile',
      'Advanced analytics & insights',
      'Featured in homepage rotation',
      'Priority customer support',
    ],
    cta: 'Start Free Trial',
    href: '/register',
    highlighted: true,
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    period: '',
    description: 'For large construction companies and agencies with multiple teams',
    features: [
      'Everything in Pro Plus',
      'Multiple team member accounts',
      'Dedicated account manager',
      'Custom branding options',
      'API access for integrations',
      'Bulk project management',
      'Invoice & payment tools',
      'Custom reporting',
    ],
    cta: 'Contact Sales',
    href: '/contact',
    highlighted: false,
  },
];
---

<BaseLayout title="Pricing" description="වැඩHUB pricing plans for homeowners and construction professionals">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-16 lg:px-8">
    <div class="text-center">
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">Simple, Transparent Pricing</h1>
      <p class="mx-auto mt-3 max-w-xl text-gray-500">Free for homeowners. Affordable plans for professionals to grow their business.</p>
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {plans.map((plan) => (
        <div class={`relative flex flex-col rounded-2xl border bg-white p-6 shadow-sm ${plan.highlighted ? 'border-brand-500 ring-2 ring-brand-500' : 'border-gray-200'}`}>
          {plan.highlighted && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white">
              Most Popular
            </div>
          )}
          <div>
            <h3 class="text-lg font-semibold text-gray-900">{plan.name}</h3>
            <div class="mt-3 flex items-baseline">
              <span class={`text-3xl font-bold ${plan.highlighted ? 'text-brand-600' : 'text-gray-900'}`}>{plan.price}</span>
              {plan.period && <span class="ml-1 text-sm text-gray-400">{plan.period}</span>}
            </div>
            <p class="mt-3 text-sm text-gray-500">{plan.description}</p>
          </div>
          <ul class="mt-6 flex-1 space-y-3">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-2 text-sm text-gray-600">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {feature}
              </li>
            ))}
          </ul>
          <a href={plan.href} class={`mt-6 block rounded-lg px-4 py-3 text-center text-sm font-semibold transition-colors ${plan.highlighted ? 'bg-brand-600 text-white hover:bg-brand-700' : 'border border-gray-300 text-gray-700 hover:bg-gray-50'}`}>
            {plan.cta}
          </a>
        </div>
      ))}
    </div>

    <!-- FAQ -->
    <div class="mx-auto mt-20 max-w-3xl">
      <h2 class="text-center text-2xl font-bold text-gray-900">Frequently Asked Questions</h2>
      <div class="mt-8 space-y-4">
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="font-semibold text-gray-900">Is it really free for homeowners?</h3>
          <p class="mt-2 text-sm text-gray-500">Yes! Homeowners can post project requests, browse professionals, receive quotes, and hire — all completely free. We charge professionals a subscription fee to connect with you.</p>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="font-semibold text-gray-900">Can I try a Pro plan before committing?</h3>
          <p class="mt-2 text-sm text-gray-500">Absolutely. All professional plans come with a 14-day free trial. No credit card required to start. You can upgrade, downgrade, or cancel at any time.</p>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="font-semibold text-gray-900">What payment methods do you accept?</h3>
          <p class="mt-2 text-sm text-gray-500">We accept all major credit/debit cards, bank transfers, and popular Sri Lankan payment methods. All prices are in LKR (Sri Lankan Rupees).</p>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="font-semibold text-gray-900">Can I switch plans anytime?</h3>
          <p class="mt-2 text-sm text-gray-500">Yes. You can upgrade or downgrade your plan at any time. If upgrading, you'll be prorated. If downgrading, the change takes effect at the end of your billing cycle.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
