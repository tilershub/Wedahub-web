---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';

const steps = [
  {
    number: '01',
    title: 'Post your job',
    description: 'Describe what you need — renovation, plumbing, painting, anything. It takes 2 minutes.',
    icon: '📋',
    color: 'bg-blue-50 text-blue-600 ring-blue-100',
  },
  {
    number: '02',
    title: 'Compare quotes',
    description: 'Verified local professionals respond with quotes. Review profiles, ratings, and portfolios.',
    icon: '💬',
    color: 'bg-violet-50 text-violet-600 ring-violet-100',
  },
  {
    number: '03',
    title: 'Get it done',
    description: 'Hire the best match, track progress, and pay securely when the job meets your standards.',
    icon: '✅',
    color: 'bg-emerald-50 text-emerald-600 ring-emerald-100',
  },
];

const trust = [
  { icon: '🛡️', label: 'Verified professionals' },
  { icon: '💸', label: 'Free to post' },
  { icon: '⭐', label: 'Rated & reviewed' },
  { icon: '🔒', label: 'Secure payments' },
];

const quickServices = services.slice(0, 8);
---

<BaseLayout
  title="Hire trusted home professionals — වැඩHUB"
  description="Find verified plumbers, electricians, builders and more across Sri Lanka. Post your job free and get quotes in hours."
>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-white">
    <!-- Subtle grid background -->
    <div class="hero-grid pointer-events-none absolute inset-0 opacity-[0.03]"></div>
    <!-- Glow blobs -->
    <div class="pointer-events-none absolute -top-32 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-brand-400 opacity-10 blur-3xl"></div>
    <div class="pointer-events-none absolute top-40 right-0 h-64 w-64 rounded-full bg-violet-400 opacity-10 blur-3xl"></div>

    <div class="relative mx-auto max-w-3xl px-5 pb-14 pt-12 text-center sm:pb-20 sm:pt-16">

      <!-- Badge -->
      <div class="fade-up inline-flex items-center gap-2 rounded-full border border-stone-200 bg-stone-50 px-4 py-1.5 text-xs font-semibold text-stone-600">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        Sri Lanka's home services platform
      </div>

      <!-- Headline -->
      <h1 class="fade-up fade-delay-1 mt-5 text-4xl font-extrabold leading-[1.1] tracking-tight text-stone-900 sm:text-5xl lg:text-6xl">
        The easiest way to hire<br />
        <span class="gradient-text">trusted local pros</span>
      </h1>

      <p class="fade-up fade-delay-2 mx-auto mt-5 max-w-lg text-base leading-relaxed text-stone-500 sm:text-lg">
        Post any home job free — plumbing, construction, electrical, interior design — and get quotes from verified professionals near you.
      </p>

      <!-- CTAs -->
      <div class="fade-up fade-delay-3 mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href="/post"
          class="group relative w-full overflow-hidden rounded-2xl bg-brand-600 px-10 py-4 text-sm font-bold text-white shadow-lg shadow-brand-600/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-600/30 active:translate-y-0 sm:w-auto"
        >
          <span class="relative z-10">Post a Job — Free</span>
          <span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-brand-500 to-brand-600 transition-transform duration-300 group-hover:translate-x-0"></span>
        </a>
        <a
          href="/professionals"
          class="w-full rounded-2xl border border-stone-200 bg-white px-10 py-4 text-center text-sm font-semibold text-stone-700 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-700 hover:shadow-md active:translate-y-0 sm:w-auto"
        >
          Browse Professionals →
        </a>
      </div>

      <!-- Quick service chips -->
      <div class="fade-up fade-delay-4 mt-8">
        <p class="mb-3 text-xs font-medium uppercase tracking-widest text-stone-400">Popular services</p>
        <div class="flex flex-wrap justify-center gap-2">
          {quickServices.map((s) => (
            <a
              href={`/professionals?service=${encodeURIComponent(s.name)}`}
              class="flex items-center gap-1.5 rounded-full border border-stone-200 bg-stone-50 px-3.5 py-1.5 text-xs font-medium text-stone-600 transition-all hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700 active:scale-95"
            >
              <span>{s.icon}</span>
              {s.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Trust bar -->
      <div class="fade-up fade-delay-5 mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {trust.map((t) => (
          <span class="flex items-center gap-1.5 text-xs text-stone-400">
            <span>{t.icon}</span>
            {t.label}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SERVICES GRID ─────────────────────────────────────────── -->
  <section class="bg-stone-50 py-14 sm:py-18">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end justify-between">
        <h2 class="text-xl font-bold text-stone-900 sm:text-2xl">What do you need done?</h2>
        <a href="/professionals" class="text-sm font-medium text-brand-600 hover:underline">View all →</a>
      </div>

      <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4 lg:gap-3.5">
        {services.map((service) => (
          <a
            href={`/professionals?service=${encodeURIComponent(service.name)}`}
            class={`service-card group flex items-center gap-3 rounded-2xl border border-stone-200/80 bg-gradient-to-br ${service.gradient} p-4 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-md active:translate-y-0 sm:p-4`}
          >
            <span class="text-xl sm:text-2xl">{service.icon}</span>
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold text-stone-800 group-hover:text-brand-700">{service.name}</p>
              <p class="hidden text-xs text-stone-400 sm:block">{service.description.split(' ').slice(0,4).join(' ')}…</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ───────────────────────────────────────────── -->
  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="mb-12 text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-500">Simple process</p>
        <h2 class="mt-2 text-2xl font-bold text-stone-900 sm:text-3xl">From post to done in 3 steps</h2>
      </div>

      <div class="relative">
        <!-- Connecting line (desktop) -->
        <div class="absolute left-0 right-0 top-10 hidden h-px bg-gradient-to-r from-transparent via-stone-200 to-transparent sm:block"></div>

        <div class="grid gap-8 sm:grid-cols-3 sm:gap-6">
          {steps.map((step, i) => (
            <div class="relative flex gap-5 sm:flex-col sm:gap-4 sm:text-center">
              <!-- Step icon -->
              <div class={`relative z-10 flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl ring-4 ${step.color} sm:mx-auto sm:h-20 sm:w-20`}>
                <span class="text-3xl">{step.icon}</span>
                <span class={`absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full bg-stone-900 text-[10px] font-bold text-white`}>
                  {i + 1}
                </span>
              </div>
              <div>
                <h3 class="text-base font-bold text-stone-900">{step.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-stone-500">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12 text-center">
        <a
          href="/post"
          class="inline-flex items-center gap-2 rounded-2xl bg-stone-900 px-10 py-3.5 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-stone-800 hover:shadow-lg active:translate-y-0"
        >
          Get started now
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FOR PROFESSIONALS ─────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-stone-950 py-16 sm:py-20">
    <!-- Glow -->
    <div class="pointer-events-none absolute left-1/2 top-0 h-64 w-64 -translate-x-1/2 rounded-full bg-brand-600 opacity-20 blur-3xl"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6">
      <div class="flex flex-col items-center gap-8 text-center lg:flex-row lg:items-center lg:gap-16 lg:text-left">

        <div class="flex-1">
          <span class="inline-block rounded-full bg-brand-500/20 px-3.5 py-1 text-xs font-semibold text-brand-400">For professionals</span>
          <h2 class="mt-4 text-2xl font-bold text-white sm:text-3xl lg:text-4xl">
            Grow your business<br class="hidden lg:block" /> with better leads
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-stone-400 sm:text-base">
            Join contractors, architects, and tradespeople across Sri Lanka. Showcase your portfolio, receive direct project leads, and get paid securely.
          </p>

          <div class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2 lg:justify-start">
            {['Free to join', 'Set your own rates', 'Build your reputation', 'Island-wide reach'].map((item) => (
              <span class="flex items-center gap-1.5 text-xs text-stone-400">
                <svg class="h-3.5 w-3.5 text-brand-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="flex shrink-0 flex-col items-center gap-3 sm:flex-row lg:flex-col">
          <a
            href="/register"
            class="w-full rounded-2xl bg-brand-600 px-10 py-4 text-center text-sm font-bold text-white shadow-lg shadow-brand-600/30 transition-all hover:-translate-y-0.5 hover:bg-brand-500 hover:shadow-brand-500/40 active:translate-y-0 sm:w-auto"
          >
            Join as a Pro — Free
          </a>
          <a
            href="/professionals"
            class="w-full rounded-2xl border border-stone-700 px-10 py-4 text-center text-sm font-semibold text-stone-300 transition-all hover:border-stone-500 hover:text-white active:scale-95 sm:w-auto"
          >
            See Professionals
          </a>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Gradient headline text */
  .gradient-text {
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Hero background grid */
  .hero-grid {
    background-image:
      linear-gradient(to right, #6b7280 1px, transparent 1px),
      linear-gradient(to bottom, #6b7280 1px, transparent 1px);
    background-size: 48px 48px;
  }

  /* Fade-up entrance animations */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-up {
    animation: fadeUp 0.6s ease-out both;
  }
  .fade-delay-1 { animation-delay: 0.05s; }
  .fade-delay-2 { animation-delay: 0.12s; }
  .fade-delay-3 { animation-delay: 0.20s; }
  .fade-delay-4 { animation-delay: 0.28s; }
  .fade-delay-5 { animation-delay: 0.36s; }

  /* Smooth hover lift for service cards */
  .service-card {
    will-change: transform;
  }
</style>
