---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
---

<BaseLayout title="Find trusted home service professionals">
  <div class="bg-stone-50 pb-10 pt-6 sm:pt-8">
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-3xl font-bold text-stone-900 sm:text-4xl">Choose a service</h1>
        <p class="mt-2 text-sm text-stone-500">Open a service page to view providers, blogs, and promotions.</p>
      </div>

      <div class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {services.map((service) => (
          <a
            href={`/services/${service.slug}`}
            class={`group rounded-2xl border border-stone-200 bg-gradient-to-br ${service.gradient} p-4 transition hover:border-brand-300 hover:shadow-md sm:p-5`}
          >
            <span class="text-2xl sm:text-3xl">{service.icon}</span>
            <h3 class="mt-2 text-sm font-semibold text-stone-900 group-hover:text-brand-700 sm:text-base">{service.name}</h3>
            <p class="mt-1 hidden text-xs leading-relaxed text-stone-500 sm:block">{service.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
