---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  { name: 'Kitchen Remodel', projects: '1.2k projects' },
  { name: 'Bathroom Renovation', projects: '980 projects' },
  { name: 'Living Rooms', projects: '840 projects' },
  { name: 'Outdoor Spaces', projects: '760 projects' },
  { name: 'New Builds', projects: '690 projects' },
  { name: 'Roofing', projects: '510 projects' },
];

const inspirationCards = [
  {
    title: 'Warm Minimalist Kitchen in Colombo',
    pro: 'By Studio Lak One',
    badge: 'Kitchen',
    gradient: 'from-amber-100 via-orange-100 to-rose-100',
  },
  {
    title: 'Compact Courtyard for Urban Homes',
    pro: 'By Greenform Landscapes',
    badge: 'Outdoor',
    gradient: 'from-emerald-100 via-lime-100 to-teal-100',
  },
  {
    title: 'Contemporary Family Living Room',
    pro: 'By Habitat Interiors',
    badge: 'Interior',
    gradient: 'from-sky-100 via-indigo-100 to-blue-100',
  },
];

const professionals = [
  {
    name: 'Sampath Builders',
    specialty: 'Design + Build',
    location: 'Colombo',
    rating: '4.9',
    projects: '128 projects',
  },
  {
    name: 'Nirosha Interior Lab',
    specialty: 'Interior Design',
    location: 'Kandy',
    rating: '4.8',
    projects: '94 projects',
  },
  {
    name: 'Modern Roof & Solar',
    specialty: 'Roofing + Solar',
    location: 'Galle',
    rating: '4.7',
    projects: '87 projects',
  },
];
---

<BaseLayout title="Find design ideas and professionals">
  <div class="bg-stone-50">
    <section class="mx-auto max-w-7xl px-4 pb-8 pt-5 sm:px-6 lg:px-8 lg:pt-8">
      <div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-stone-200">
        <div class="grid gap-6 p-5 sm:p-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-700">Mobile-first home renovation marketplace</span>
            <h1 class="mt-4 text-3xl font-semibold leading-tight text-stone-900 sm:text-4xl">
              Discover ideas, plan your space, and hire trusted home pros.
            </h1>
            <p class="mt-3 text-sm leading-6 text-stone-600 sm:text-base">
              A Houzz-inspired experience for Sri Lanka: browse project photos, save inspiration, and connect with verified builders and designers.
            </p>

            <form class="mt-6 grid gap-3 sm:grid-cols-[1fr_auto]" action="/professionals" method="get">
              <label class="sr-only" for="search">Search service or style</label>
              <input id="search" name="q" type="search" placeholder="Search kitchens, contractors, interiors..." class="w-full rounded-2xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-700 outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-100" />
              <button type="submit" class="rounded-2xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-700">Find pros</button>
            </form>

            <div class="mt-4 flex flex-wrap gap-2 text-xs text-stone-500">
              <span class="rounded-full bg-stone-100 px-3 py-1">12k+ photos</span>
              <span class="rounded-full bg-stone-100 px-3 py-1">2.3k verified pros</span>
              <span class="rounded-full bg-stone-100 px-3 py-1">Fast quote requests</span>
            </div>
          </div>

          <div class="rounded-2xl bg-gradient-to-br from-brand-100 via-amber-50 to-white p-5 ring-1 ring-brand-100">
            <h2 class="text-sm font-semibold text-stone-900">Popular right now</h2>
            <ul class="mt-4 space-y-3">
              <li class="flex items-center justify-between rounded-xl bg-white px-3 py-2 text-sm">
                <span>Japandi Living Rooms</span>
                <span class="text-stone-500">#1</span>
              </li>
              <li class="flex items-center justify-between rounded-xl bg-white px-3 py-2 text-sm">
                <span>Small Kitchen Layouts</span>
                <span class="text-stone-500">#2</span>
              </li>
              <li class="flex items-center justify-between rounded-xl bg-white px-3 py-2 text-sm">
                <span>Courtyard Landscaping</span>
                <span class="text-stone-500">#3</span>
              </li>
            </ul>
            <a href="/projects" class="mt-4 inline-flex text-sm font-semibold text-brand-700 hover:text-brand-800">Browse all photos →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-stone-900 sm:text-xl">Browse by category</h2>
        <a href="/professionals" class="text-sm font-medium text-brand-700">See all</a>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {categories.map((category) => (
          <a href="/professionals" class="rounded-2xl border border-stone-200 bg-white p-4 transition hover:border-brand-300 hover:shadow-sm">
            <p class="text-sm font-semibold text-stone-900">{category.name}</p>
            <p class="mt-1 text-xs text-stone-500">{category.projects}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-stone-900 sm:text-xl">Inspiration for your next project</h2>
        <a href="/projects" class="text-sm font-medium text-brand-700">View gallery</a>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {inspirationCards.map((card) => (
          <article class="overflow-hidden rounded-2xl border border-stone-200 bg-white">
            <div class={`aspect-[4/3] bg-gradient-to-br ${card.gradient}`}></div>
            <div class="p-4">
              <span class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-600">{card.badge}</span>
              <h3 class="mt-3 text-base font-semibold text-stone-900">{card.title}</h3>
              <p class="mt-1 text-sm text-stone-600">{card.pro}</p>
              <a href="/projects" class="mt-3 inline-flex text-sm font-semibold text-brand-700">Save idea +</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-stone-200 sm:p-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-lg font-semibold text-stone-900 sm:text-xl">Top-rated professionals near you</h2>
            <p class="text-sm text-stone-600">Compare portfolios, reviews, and response times before hiring.</p>
          </div>
          <a href="/professionals" class="text-sm font-semibold text-brand-700">Explore professionals</a>
        </div>

        <div class="mt-5 grid gap-4 lg:grid-cols-3">
          {professionals.map((pro) => (
            <article class="rounded-2xl border border-stone-200 p-4">
              <div class="flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-stone-100 text-sm font-bold text-stone-700">
                  {pro.name
                    .split(' ')
                    .slice(0, 2)
                    .map((word) => word[0])
                    .join('')}
                </div>
                <div>
                  <h3 class="font-semibold text-stone-900">{pro.name}</h3>
                  <p class="text-xs text-stone-500">{pro.specialty}</p>
                </div>
              </div>
              <div class="mt-4 flex flex-wrap gap-2 text-xs text-stone-600">
                <span class="rounded-full bg-stone-100 px-2.5 py-1">⭐ {pro.rating}</span>
                <span class="rounded-full bg-stone-100 px-2.5 py-1">{pro.projects}</span>
                <span class="rounded-full bg-stone-100 px-2.5 py-1">{pro.location}</span>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-2">
                <a href="/professionals" class="rounded-xl border border-stone-200 px-3 py-2 text-center text-xs font-semibold text-stone-700">View profile</a>
                <a href="/post" class="rounded-xl bg-brand-600 px-3 py-2 text-center text-xs font-semibold text-white">Request quote</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
