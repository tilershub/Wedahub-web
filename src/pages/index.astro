<script>
  import { supabase } from '../lib/supabase';

  async function initFeed() {
    const { data: { user } } = await supabase.auth.getUser();

    if (user) {
      const name = user.user_metadata?.full_name || user.email || 'User';
      const role = user.user_metadata?.role || 'homeowner';
      const isPro = role === 'professional';
      const initials = name.split(' ').map((n: string) => n[0]).join('').toUpperCase().slice(0, 2);

      // Update sidebar user card
      document.getElementById('sidebar-guest')?.classList.add('hidden');
      const sidebarUser = document.getElementById('sidebar-user')!;
      sidebarUser.classList.remove('hidden');
      document.getElementById('sidebar-avatar')!.textContent = initials;
      document.getElementById('sidebar-name')!.textContent = name;
      document.getElementById('sidebar-role')!.textContent = isPro ? 'Professional' : 'Homeowner';

      // Update sidebar links based on role
      const linksEl = document.getElementById('sidebar-links')!;
      if (isPro) {
        linksEl.innerHTML = `
          <a href="/dashboard" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50"><span>📊</span> Dashboard</a>
          <a href="/pro/profile" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50"><span>⚙️</span> Business Profile</a>
          <a href="/pro/projects" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50"><span>📂</span> My Projects</a>
          <a href="/pro/add-project" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50"><span>📸</span> Add Project</a>
          <a href="/projects" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50"><span>📋</span> Browse Requests</a>
        `;
      } else {
        linksEl.innerHTML = `
          <a href="/dashboard" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50"><span>📊</span> Dashboard</a>
          <a href="/post" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50"><span>📋</span> Post a Project</a>
          <a href="/professionals" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50"><span>🔍</span> Find Professionals</a>
          <a href="/projects" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50"><span>🏠</span> Browse Projects</a>
        `;
      }

      // Update feed create-post avatar
      document.getElementById('feed-avatar')!.textContent = initials;
    }
  }

  initFeed();
</script>
