---
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceCategories = [
  { name: 'All', icon: '🏠' },
  { name: 'General Construction', icon: '🏗️' },
  { name: 'Architecture & Design', icon: '📐' },
  { name: 'Interior Design', icon: '🎨' },
  { name: 'Plumbing', icon: '🚿' },
  { name: 'Electrical Work', icon: '⚡' },
  { name: 'Masonry & Tiling', icon: '🧱' },
  { name: 'Carpentry & Woodwork', icon: '🪚' },
  { name: 'Painting & Finishing', icon: '🖌️' },
  { name: 'Roofing', icon: '🏘️' },
  { name: 'Landscaping', icon: '🌿' },
  { name: 'Welding & Metalwork', icon: '🔧' },
  { name: 'Waterproofing', icon: '💧' },
];
---

<BaseLayout title="Home">
  <div class="mx-auto max-w-7xl px-4 pt-6 pb-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[1fr_2fr_1fr]">

      <!-- ============================================ -->
      <!-- LEFT SIDEBAR -->
      <!-- ============================================ -->
      <aside class="hidden lg:block">
        <div class="sticky top-20 space-y-4">
          <!-- User Quick Card (shown for logged-in users via JS) -->
          <div id="sidebar-user" class="hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-100 text-lg font-bold text-brand-700" id="sidebar-avatar">U</div>
              <div>
                <div class="font-semibold text-gray-900" id="sidebar-name">User</div>
                <div class="text-xs text-gray-400" id="sidebar-role">Member</div>
              </div>
            </div>
            <div class="mt-4 space-y-1" id="sidebar-links">
              <a href="/dashboard" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50">
                <span>📊</span> Dashboard
              </a>
            </div>
          </div>

          <!-- Guest Quick Card -->
          <div id="sidebar-guest" class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
            <h3 class="font-semibold text-gray-900">Welcome to වැඩHUB</h3>
            <p class="mt-1 text-sm text-gray-500">Sri Lanka's construction marketplace</p>
            <div class="mt-4 space-y-2">
              <a href="/register" class="btn-primary w-full text-center text-sm">Create Account</a>
              <a href="/login" class="btn-secondary w-full text-center text-sm">Log In</a>
            </div>
          </div>

          <!-- Categories -->
          <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
            <h3 class="text-sm font-semibold text-gray-900">Categories</h3>
            <nav class="mt-3 space-y-0.5">
              {serviceCategories.map((cat) => (
                <a href="/professionals" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 transition-colors hover:bg-gray-50 hover:text-brand-600">
                  <span>{cat.icon}</span>
                  <span>{cat.name}</span>
                </a>
              ))}
            </nav>
          </div>
        </div>
      </aside>

      <!-- ============================================ -->
      <!-- MAIN FEED -->
      <!-- ============================================ -->
      <main>
        <!-- Create Post Bar -->
        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700" id="feed-avatar">W</div>
            <a href="/post" class="flex-1 rounded-full bg-gray-100 px-4 py-2.5 text-sm text-gray-400 transition-colors hover:bg-gray-200">
              What construction work do you need done?
            </a>
          </div>
          <div class="mt-3 flex border-t border-gray-100 pt-3">
            <a href="/post" class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
              <span>📋</span> Post Request
            </a>
            <a href="/pro/add-project" class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
              <span>📸</span> Add Project
            </a>
            <a href="/professionals" class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
              <span>🔍</span> Find Pros
            </a>
          </div>
        </div>

        <!-- Stories / Featured Pros Bar -->
        <div class="mt-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <h3 class="text-sm font-semibold text-gray-500">Featured Professionals</h3>
          <div class="mt-3 flex gap-4 overflow-x-auto pb-2">
            <a href="/professionals" class="flex shrink-0 flex-col items-center gap-1.5">
              <div class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-brand-500 bg-brand-100 p-0.5">
                <div class="flex h-full w-full items-center justify-center rounded-full bg-brand-50 text-lg font-bold text-brand-700">SR</div>
              </div>
              <span class="w-16 truncate text-center text-xs text-gray-500">Sampath R.</span>
            </a>
            <a href="/professionals" class="flex shrink-0 flex-col items-center gap-1.5">
              <div class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-accent-500 bg-accent-100 p-0.5">
                <div class="flex h-full w-full items-center justify-center rounded-full bg-accent-50 text-lg font-bold text-accent-700">NF</div>
              </div>
              <span class="w-16 truncate text-center text-xs text-gray-500">Nirosha F.</span>
            </a>
            <a href="/professionals" class="flex shrink-0 flex-col items-center gap-1.5">
              <div class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-blue-500 bg-blue-100 p-0.5">
                <div class="flex h-full w-full items-center justify-center rounded-full bg-blue-50 text-lg font-bold text-blue-700">KP</div>
              </div>
              <span class="w-16 truncate text-center text-xs text-gray-500">Kamal P.</span>
            </a>
            <a href="/professionals" class="flex shrink-0 flex-col items-center gap-1.5">
              <div class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-yellow-500 bg-yellow-100 p-0.5">
                <div class="flex h-full w-full items-center justify-center rounded-full bg-yellow-50 text-lg font-bold text-yellow-700">DA</div>
              </div>
              <span class="w-16 truncate text-center text-xs text-gray-500">Dinesh A.</span>
            </a>
            <a href="/professionals" class="flex shrink-0 flex-col items-center gap-1.5">
              <div class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-pink-500 bg-pink-100 p-0.5">
                <div class="flex h-full w-full items-center justify-center rounded-full bg-pink-50 text-lg font-bold text-pink-700">MW</div>
              </div>
              <span class="w-16 truncate text-center text-xs text-gray-500">Malini W.</span>
            </a>
            <a href="/professionals" class="flex shrink-0 flex-col items-center gap-1.5">
              <div class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-orange-500 bg-orange-100 p-0.5">
                <div class="flex h-full w-full items-center justify-center rounded-full bg-orange-50 text-lg font-bold text-orange-700">RJ</div>
              </div>
              <span class="w-16 truncate text-center text-xs text-gray-500">Ruwan J.</span>
            </a>
          </div>
        </div>

        <!-- FEED POSTS -->
        <div class="mt-4 space-y-4" id="feed">

          <!-- Feed Post: Project by Pro -->
          <article class="rounded-xl border border-gray-200 bg-white shadow-sm">
            <div class="p-4">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">SR</div>
                <div class="flex-1">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-gray-900">Sampath Rajapaksa</span>
                    <span class="rounded-full bg-green-100 px-1.5 py-0.5 text-[10px] font-medium text-green-700">Verified</span>
                  </div>
                  <div class="flex items-center gap-2 text-xs text-gray-400">
                    <span>General Construction, Roofing</span>
                    <span>&middot;</span>
                    <span>2 hours ago</span>
                  </div>
                </div>
                <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700">Project</span>
              </div>
              <h3 class="mt-3 font-semibold text-gray-900">Modern Two-Story Family Home</h3>
              <p class="mt-1 text-sm text-gray-600">Just completed this 3,200 sq ft contemporary home with open floor plan, 4 bedrooms, and a rooftop terrace in Colombo 7. Took us 14 months from foundation to handover.</p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">New Build</span>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">Colombo 7</span>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">LKR 18M</span>
              </div>
            </div>
            <div class="aspect-video bg-gradient-to-br from-brand-100 to-brand-200 flex items-center justify-center">
              <span class="text-7xl">🏠</span>
            </div>
            <div class="p-4">
              <div class="flex items-center justify-between text-xs text-gray-400">
                <span>24 likes</span>
                <span>8 comments</span>
              </div>
              <div class="mt-3 flex border-t border-gray-100 pt-3">
                <button class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" /></svg>
                  Like
                </button>
                <button class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                  Comment
                </button>
                <button class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
                  Share
                </button>
                <a href="/post" class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-brand-600 hover:bg-brand-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                  Get Quote
                </a>
              </div>
            </div>
          </article>

          <!-- Feed Post: Homeowner Request -->
          <article class="rounded-xl border border-gray-200 bg-white shadow-sm">
            <div class="p-4">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-200 text-sm font-bold text-gray-600">AN</div>
                <div class="flex-1">
                  <span class="font-semibold text-gray-900">Anusha Navaratne</span>
                  <div class="flex items-center gap-2 text-xs text-gray-400">
                    <span>Homeowner</span>
                    <span>&middot;</span>
                    <span>5 hours ago</span>
                  </div>
                </div>
                <span class="rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-700">Request</span>
              </div>
              <h3 class="mt-3 font-semibold text-gray-900">Need Kitchen Renovation - Complete Remodel</h3>
              <p class="mt-1 text-sm text-gray-600">Looking for an experienced contractor to renovate our kitchen. Need new cabinets, granite countertops, tiling, plumbing updates, and new lighting. Kitchen is about 150 sq ft.</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700">Interior Design</span>
                <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700">Renovation</span>
              </div>
              <div class="mt-3 flex items-center gap-4 text-sm">
                <span class="font-semibold text-green-600">LKR 1.5M - 3M</span>
                <span class="text-gray-400">Kandy</span>
                <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Open &middot; 3 quotes</span>
              </div>
            </div>
            <div class="border-t border-gray-100 p-4">
              <div class="flex">
                <button class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" /></svg>
                  Like
                </button>
                <button class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                  Comment
                </button>
                <button class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-brand-600 hover:bg-brand-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  Send Quote
                </button>
              </div>
            </div>
          </article>

          <!-- Feed Post: Pro Project with photos -->
          <article class="rounded-xl border border-gray-200 bg-white shadow-sm">
            <div class="p-4">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-pink-100 text-sm font-bold text-pink-700">MW</div>
                <div class="flex-1">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-gray-900">Malini Wickramasinghe</span>
                    <span class="rounded-full bg-green-100 px-1.5 py-0.5 text-[10px] font-medium text-green-700">Verified</span>
                  </div>
                  <div class="flex items-center gap-2 text-xs text-gray-400">
                    <span>Interior Design, Painting & Finishing</span>
                    <span>&middot;</span>
                    <span>Yesterday</span>
                  </div>
                </div>
                <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700">Project</span>
              </div>
              <h3 class="mt-3 font-semibold text-gray-900">Modern Kitchen Renovation - Before & After</h3>
              <p class="mt-1 text-sm text-gray-600">Complete kitchen remodel in Kandy. Custom walnut cabinetry, granite countertops, under-cabinet LED lighting, and new plumbing throughout. The client wanted a modern open-plan feel while keeping the traditional charm.</p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">Kitchen</span>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">Kandy</span>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">LKR 2.5M</span>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">3 months</span>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-0.5">
              <div class="aspect-video bg-gradient-to-br from-gray-200 to-gray-300 flex flex-col items-center justify-center">
                <span class="text-4xl">🔨</span>
                <span class="mt-1 text-xs font-medium text-gray-500">Before</span>
              </div>
              <div class="aspect-video bg-gradient-to-br from-amber-100 to-amber-200 flex flex-col items-center justify-center">
                <span class="text-4xl">🍳</span>
                <span class="mt-1 text-xs font-medium text-amber-700">After</span>
              </div>
            </div>
            <div class="p-4">
              <div class="flex items-center justify-between text-xs text-gray-400">
                <span>42 likes</span>
                <span>15 comments</span>
              </div>
              <div class="mt-3 flex border-t border-gray-100 pt-3">
                <button class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" /></svg>
                  Like
                </button>
                <button class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                  Comment
                </button>
                <button class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-gray-500 hover:bg-gray-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
                  Share
                </button>
                <a href="/post" class="flex flex-1 items-center justify-center gap-2 rounded-lg py-2 text-sm font-medium text-brand-600 hover:bg-brand-50">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                  Get Quote
                </a>
              </div>
            </div>
          </article>

          <!-- Feed Post: Pro Project - Landscaping -->
          <article class="rounded-xl border border-gray-200 bg-white shadow-sm">
            <div class="p-4">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-green-100 text-sm font-bold text-green-700">AS</div>
                <div class="flex-1">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-gray-900">Asanka Silva</span>
                    <span class="rounded-full bg-green-100 px-1.5 py-0.5 text-[10px] font-medium text-green-700">Verified</span>
                  </div>
                  <div class="flex items-center gap-2 text-xs text-gray-400">
                    <span>Landscaping, Masonry & Tiling</span>
                    <span>&middot;</span>
                    <span>2 days ago</span>
                  </div>
                </div>
                <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700">Project</span>
              </div>
              <h3 class="mt-3 font-semibold text-gray-900">Tropical Garden & Infinity Pool</h3>
              <p class="mt-1 text-sm text-gray-600">Full landscape design and build in Negombo. Infinity pool, tropical plantings, natural stone pathways, outdoor BBQ area, and LED garden lighting. The backyard went from bare land to a tropical paradise!</p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">Landscaping</span>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">Negombo</span>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">LKR 4.5M</span>
              </div>
            </div>
            <div class="aspect-video bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center">
              <span class="text-7xl">🌿</span>
            </div>
            <div class="p-4">
              <div class="flex items-center justify-between text-xs text-gray-400">
                <span>56 likes</span>
                <span>22 comments</span>
