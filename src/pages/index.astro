---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
---

<BaseLayout title="Find trusted home service professionals">
  <div class="bg-stone-50">
    <!-- Hero -->
    <section class="mx-auto max-w-7xl px-4 pb-6 pt-5 sm:px-6 lg:px-8 lg:pt-8">
      <div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-stone-200">
        <div class="p-6 text-center sm:p-10">
          <h1 class="text-3xl font-bold leading-tight text-stone-900 sm:text-4xl lg:text-5xl">
            Find the right pro for your <span class="text-brand-600">home project</span>
          </h1>
          <p class="mx-auto mt-3 max-w-2xl text-sm leading-6 text-stone-600 sm:text-base">
            Browse services, compare verified professionals by ratings and completed projects, and get quotes instantly.
          </p>

          <form class="mx-auto mt-6 grid max-w-xl gap-3 sm:grid-cols-[1fr_auto]" action="/professionals" method="get">
            <label class="sr-only" for="search">Search services</label>
            <input id="search" name="q" type="search" placeholder="What do you need help with?" class="w-full rounded-2xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-700 outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-100" />
            <button type="submit" class="rounded-2xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-700">Search</button>
          </form>

          <div class="mt-4 flex flex-wrap justify-center gap-2 text-xs text-stone-500">
            <span class="rounded-full bg-stone-100 px-3 py-1">2,300+ verified pros</span>
            <span class="rounded-full bg-stone-100 px-3 py-1">Free quotes</span>
            <span class="rounded-full bg-stone-100 px-3 py-1">All 25 districts</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-xl font-semibold text-stone-900 sm:text-2xl">Our Services</h2>
        <p class="mt-1 text-sm text-stone-500">Choose a service to find top-rated professionals</p>
      </div>

      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {services.map((service) => (
          <a
            href={`/services/${service.slug}`}
            class={`group rounded-2xl border border-stone-200 bg-gradient-to-br ${service.gradient} p-4 transition hover:border-brand-300 hover:shadow-md sm:p-5`}
          >
            <span class="text-2xl sm:text-3xl">{service.icon}</span>
            <h3 class="mt-2 text-sm font-semibold text-stone-900 group-hover:text-brand-700 sm:text-base">{service.name}</h3>
            <p class="mt-1 hidden text-xs leading-relaxed text-stone-500 sm:block">{service.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- How It Works -->
    <section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
      <h2 class="text-center text-xl font-semibold text-stone-900 sm:text-2xl">How it works</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-stone-200 bg-white p-5 text-center">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">1</div>
          <h3 class="mt-3 text-sm font-semibold text-stone-900">Choose a service</h3>
          <p class="mt-1 text-xs text-stone-500">Pick the service you need from the categories above</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-5 text-center">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">2</div>
          <h3 class="mt-3 text-sm font-semibold text-stone-900">Browse professionals</h3>
          <p class="mt-1 text-xs text-stone-500">Compare ratings, completed jobs, and reviews</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-5 text-center">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">3</div>
          <h3 class="mt-3 text-sm font-semibold text-stone-900">Get a quote or site visit</h3>
          <p class="mt-1 text-xs text-stone-500">Send an instant request directly to the professional</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-5 text-center">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">4</div>
          <h3 class="mt-3 text-sm font-semibold text-stone-900">Hire with confidence</h3>
          <p class="mt-1 text-xs text-stone-500">Review their portfolio and start your project</p>
        </div>
      </div>
    </section>

    <!-- Auth-aware CTA -->
    <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
      <div id="home-guest-cta" class="rounded-3xl bg-brand-900 p-6 text-center sm:p-10">
        <h2 class="text-xl font-semibold text-white sm:text-2xl">Ready to start your project?</h2>
        <p class="mx-auto mt-2 max-w-lg text-sm text-brand-200">Join thousands of homeowners and professionals building better across Sri Lanka.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/register" class="rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-brand-700 transition hover:bg-stone-100">Create free account</a>
          <a href="/professionals" class="rounded-2xl border border-brand-400 px-6 py-3 text-sm font-semibold text-brand-200 transition hover:bg-brand-800">Browse professionals</a>
        </div>
      </div>
      <div id="home-user-cta" class="hidden rounded-3xl bg-gradient-to-r from-brand-900 to-brand-800 p-6 sm:p-10">
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
          <div>
            <h2 class="text-xl font-semibold text-white" id="home-user-greeting">Welcome back!</h2>
            <p class="mt-1 text-sm text-brand-200" id="home-user-subtitle">What would you like to do today?</p>
          </div>
          <div class="flex gap-3" id="home-user-actions">
            <a href="/dashboard" class="rounded-2xl bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 transition hover:bg-stone-100">Dashboard</a>
            <a href="/post" class="rounded-2xl border border-brand-400 px-5 py-2.5 text-sm font-semibold text-brand-200 transition hover:bg-brand-800">Post project</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  async function initHome() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;

    const name = user.user_metadata?.full_name || user.email?.split('@')[0] || 'User';
    const role = user.user_metadata?.role || 'homeowner';
    const isPro = role === 'professional';

    document.getElementById('home-guest-cta')?.classList.add('hidden');
    const userCta = document.getElementById('home-user-cta');
    userCta?.classList.remove('hidden');

    document.getElementById('home-user-greeting')!.textContent = `Welcome back, ${name}!`;
    document.getElementById('home-user-subtitle')!.textContent = isPro
      ? 'Check your leads or add a new project.'
      : 'Post a project or browse professionals.';

    if (isPro) {
      const actions = document.getElementById('home-user-actions')!;
      actions.innerHTML = `
        <a href="/dashboard" class="rounded-2xl bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 transition hover:bg-stone-100">Dashboard</a>
        <a href="/pro/add-project" class="rounded-2xl border border-brand-400 px-5 py-2.5 text-sm font-semibold text-brand-200 transition hover:bg-brand-800">Add project</a>
      `;
    }
  }

  initHome();
</script>
