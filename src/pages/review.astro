---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Write a Review" description="Review a professional on වැඩHUB">
  <section class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <div id="page-loading" class="py-20 text-center text-gray-400">Loading...</div>

    <div id="page-unauthenticated" class="hidden py-20 text-center">
      <div class="text-5xl">🔐</div>
      <h2 class="mt-4 text-2xl font-bold text-gray-900">Please log in</h2>
      <p class="mt-2 text-gray-500">You need to be logged in to write a review.</p>
      <a href="/login" class="btn-primary mt-6 inline-block">Log In</a>
    </div>

    <div id="page-error" class="hidden py-20 text-center">
      <div class="text-5xl">😕</div>
      <h2 class="mt-4 text-xl font-semibold text-gray-900">Cannot write review</h2>
      <p class="mt-2 text-sm text-gray-500" id="error-msg">Invalid review link.</p>
      <a href="/my-projects" class="btn-secondary mt-6 inline-block">My Projects</a>
    </div>

    <div id="page-already-reviewed" class="hidden py-20 text-center">
      <div class="text-5xl">✅</div>
      <h2 class="mt-4 text-xl font-semibold text-gray-900">Review already submitted</h2>
      <p class="mt-2 text-sm text-gray-500">You've already reviewed this professional for this project.</p>
      <a href="/my-projects" class="btn-secondary mt-6 inline-block">My Projects</a>
    </div>

    <div id="page-success" class="hidden py-20 text-center">
      <div class="text-5xl">🌟</div>
      <h2 class="mt-4 text-xl font-semibold text-gray-900">Thank you for your review!</h2>
      <p class="mt-2 text-sm text-gray-500">Your review has been submitted and will help other homeowners.</p>
      <a href="/my-projects" class="btn-primary mt-6 inline-block">Back to My Projects</a>
    </div>

    <div id="page-content" class="hidden">
      <div>
        <a href="/my-projects" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-brand-700">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          My Projects
        </a>
        <h1 class="mt-4 text-2xl font-bold text-gray-900 sm:text-3xl">Write a Review</h1>
        <p class="mt-1 text-sm text-gray-500">Share your experience with <span id="pro-name" class="font-medium text-gray-700"></span></p>
      </div>

      <form id="review-form" class="mt-8 space-y-6">
        <div class="card space-y-6">
          <!-- Star Rating -->
          <div>
            <label class="block text-sm font-medium text-gray-700">Overall Rating</label>
            <div class="mt-3 flex items-center gap-1" id="star-container">
              <button type="button" data-value="1" class="star-btn text-3xl text-gray-300 hover:text-amber-400 transition-colors">★</button>
              <button type="button" data-value="2" class="star-btn text-3xl text-gray-300 hover:text-amber-400 transition-colors">★</button>
              <button type="button" data-value="3" class="star-btn text-3xl text-gray-300 hover:text-amber-400 transition-colors">★</button>
              <button type="button" data-value="4" class="star-btn text-3xl text-gray-300 hover:text-amber-400 transition-colors">★</button>
              <button type="button" data-value="5" class="star-btn text-3xl text-gray-300 hover:text-amber-400 transition-colors">★</button>
            </div>
            <p class="mt-1 text-xs text-gray-400" id="rating-label">Click to rate</p>
            <input type="hidden" id="rating-value" name="rating" value="" />
          </div>

          <!-- Comment -->
          <div>
            <label for="comment" class="block text-sm font-medium text-gray-700">Your Review</label>
            <textarea
              id="comment"
              name="comment"
              rows="5"
              placeholder="Describe your experience: Was the work done on time? Was the quality good? Would you recommend this professional?"
              class="input-field mt-1 resize-y"
            ></textarea>
          </div>
        </div>

        <div id="form-error" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600"></div>

        <div class="flex gap-4">
          <button type="submit" class="btn-primary">Submit Review</button>
          <a href="/my-projects" class="btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const pageLoading = document.getElementById('page-loading')!;
  const pageContent = document.getElementById('page-content')!;
  const pageUnauthenticated = document.getElementById('page-unauthenticated')!;
  const pageError = document.getElementById('page-error')!;
  const pageAlreadyReviewed = document.getElementById('page-already-reviewed')!;
  const pageSuccess = document.getElementById('page-success')!;
  const formError = document.getElementById('form-error')!;
  const ratingLabel = document.getElementById('rating-label')!;
  const ratingInput = document.getElementById('rating-value') as HTMLInputElement;

  const ratingLabels = ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
  let selectedRating = 0;
  let projectId = '';
  let professionalId = '';
  let currentUserId = '';

  // Star rating interaction
  const starBtns = document.querySelectorAll<HTMLButtonElement>('.star-btn');

  function updateStars(rating: number) {
    starBtns.forEach(btn => {
      const val = Number(btn.dataset.value);
      btn.classList.toggle('text-amber-400', val <= rating);
      btn.classList.toggle('text-gray-300', val > rating);
    });
    ratingLabel.textContent = ratingLabels[rating] || 'Click to rate';
  }

  starBtns.forEach(btn => {
    btn.addEventListener('mouseenter', () => updateStars(Number(btn.dataset.value)));
    btn.addEventListener('mouseleave', () => updateStars(selectedRating));
    btn.addEventListener('click', () => {
      selectedRating = Number(btn.dataset.value);
      ratingInput.value = String(selectedRating);
      updateStars(selectedRating);
    });
  });

  // Form submit
  const form = document.getElementById('review-form') as HTMLFormElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.add('hidden');

    if (!selectedRating) {
      formError.textContent = 'Please select a star rating.';
      formError.classList.remove('hidden');
      return;
    }

    const comment = (document.getElementById('comment') as HTMLTextAreaElement).value.trim();

    const { error } = await supabase.from('reviews').insert({
      project_id: projectId,
      reviewer_id: currentUserId,
      professional_id: professionalId,
      rating: selectedRating,
      comment: comment || null,
    });

    if (error) {
      formError.textContent = error.message;
      formError.classList.remove('hidden');
      return;
    }

    pageContent.classList.add('hidden');
    pageSuccess.classList.remove('hidden');
  });

  async function init() {
    const params = new URLSearchParams(window.location.search);
    projectId = params.get('project_id') || '';
    professionalId = params.get('professional_id') || '';

    const { data: { user } } = await supabase.auth.getUser();
    pageLoading.classList.add('hidden');

    if (!user) {
      pageUnauthenticated.classList.remove('hidden');
      return;
    }

    currentUserId = user.id;

    if (!projectId || !professionalId) {
      document.getElementById('error-msg')!.textContent = 'Invalid review link. Missing project or professional info.';
      pageError.classList.remove('hidden');
      return;
    }

    // Check the project belongs to this user
    const { data: project } = await supabase
      .from('projects')
      .select('id, title')
      .eq('id', projectId)
      .eq('user_id', user.id)
      .single();

    if (!project) {
      document.getElementById('error-msg')!.textContent = 'Project not found or does not belong to you.';
      pageError.classList.remove('hidden');
      return;
    }

    // Check not already reviewed
    const { data: existing } = await supabase
      .from('reviews')
      .select('id')
      .eq('project_id', projectId)
      .eq('reviewer_id', user.id)
      .maybeSingle();

    if (existing) {
      pageAlreadyReviewed.classList.remove('hidden');
      return;
    }

    // Load professional name
    const { data: proProfile } = await supabase
      .from('professional_profiles')
      .select('company_name')
      .eq('id', professionalId)
      .maybeSingle();

    const { data: profile } = await supabase
      .from('profiles')
      .select('full_name')
      .eq('id', professionalId)
      .maybeSingle();

    const proName = proProfile?.company_name || profile?.full_name || 'this professional';
    document.getElementById('pro-name')!.textContent = proName;

    pageContent.classList.remove('hidden');
  }

  init();
</script>
