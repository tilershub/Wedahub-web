---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us" description="Get in touch with the වැඩHUB team">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-16 lg:px-8">
    <div class="text-center">
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">Contact Us</h1>
      <p class="mx-auto mt-3 max-w-xl text-gray-500">Have a question, suggestion, or need support? We'd love to hear from you.</p>
    </div>

    <div class="mx-auto mt-12 grid max-w-5xl gap-10 lg:grid-cols-5">
      <!-- Contact Info -->
      <div class="space-y-6 lg:col-span-2">
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Email</h3>
              <p class="mt-1 text-sm text-gray-500">support@wedahub.lk</p>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Phone</h3>
              <p class="mt-1 text-sm text-gray-500">+94 11 234 5678</p>
              <p class="text-xs text-gray-400">Mon-Fri, 9am - 6pm</p>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Office</h3>
              <p class="mt-1 text-sm text-gray-500">42 Galle Road, Colombo 03<br>Sri Lanka</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-3">
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
          <h2 class="text-lg font-semibold text-gray-900">Send us a message</h2>
          <form id="contact-form" class="mt-6 space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
                <input type="text" id="name" name="name" required placeholder="Your name" class="input-field mt-1" />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                <input type="email" id="email" name="email" required placeholder="you@example.com" class="input-field mt-1" />
              </div>
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700">Subject</label>
              <select id="subject" name="subject" required class="input-field mt-1">
                <option value="">Select a topic</option>
                <option value="general">General Inquiry</option>
                <option value="support">Account Support</option>
                <option value="pro">Professional Registration</option>
                <option value="report">Report an Issue</option>
                <option value="feedback">Feedback / Suggestion</option>
                <option value="partnership">Partnership Inquiry</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700">Message</label>
              <textarea id="message" name="message" rows="5" required placeholder="Tell us how we can help..." class="input-field mt-1"></textarea>
            </div>

            <div id="contact-error" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600"></div>
            <div id="contact-success" class="hidden rounded-lg bg-green-50 p-3 text-sm text-green-600"></div>

            <button type="submit" id="contact-btn" class="btn-primary w-full sm:w-auto">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successEl = document.getElementById('contact-success') as HTMLDivElement;
  const errorEl = document.getElementById('contact-error') as HTMLDivElement;
  const btn = document.getElementById('contact-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Sending...';

    // Simulate sending (in production, connect to a backend/email service)
    await new Promise(r => setTimeout(r, 1000));

    successEl.textContent = 'Thank you! Your message has been sent. We\'ll get back to you within 24 hours.';
    successEl.classList.remove('hidden');
    form.reset();
    btn.disabled = false;
    btn.textContent = 'Send Message';
  });
</script>
