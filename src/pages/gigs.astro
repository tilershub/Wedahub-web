---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  'All',
  'Web Development',
  'Graphic Design',
  'Content Writing',
  'Digital Marketing',
  'Video & Animation',
  'Translation',
  'Data Entry',
  'Photography',
];
---

<BaseLayout title="Find Work" description="Browse available gigs and freelance opportunities on වැඩHUB">
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Find Work</h1>
        <p class="mt-1 text-gray-500">Browse available gigs and freelance opportunities</p>
      </div>
      <div class="flex gap-3">
        <input
          type="search"
          placeholder="Search gigs..."
          class="input-field w-64"
          id="search-input"
        />
      </div>
    </div>

    <!-- Category Filter -->
    <div class="mt-8 flex flex-wrap gap-2">
      {categories.map((cat, i) => (
        <button
          class:list={[
            'rounded-full px-4 py-2 text-sm font-medium transition-colors',
            i === 0
              ? 'bg-brand-600 text-white'
              : 'bg-gray-100 text-gray-600 hover:bg-gray-200',
          ]}
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Gigs Grid -->
    <div id="gigs-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Placeholder gigs -->
      <div class="card">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">JS</div>
          <div>
            <div class="font-semibold text-gray-900">Full-Stack Web Developer</div>
            <div class="text-xs text-gray-400">Posted 2 hours ago</div>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Looking for an experienced full-stack developer to build a custom e-commerce platform using React and Node.js.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">React</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">Node.js</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">PostgreSQL</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <span class="text-sm font-semibold text-green-600">LKR 150,000</span>
          <span class="text-xs text-gray-400">Web Development</span>
        </div>
      </div>

      <div class="card">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-100 text-sm font-bold text-accent-700">AB</div>
          <div>
            <div class="font-semibold text-gray-900">Logo & Brand Identity Design</div>
            <div class="text-xs text-gray-400">Posted 5 hours ago</div>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Need a creative designer to create a modern logo and brand identity for a new tech startup based in Colombo.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full bg-accent-50 px-3 py-1 text-xs font-medium text-accent-700">Illustrator</span>
          <span class="rounded-full bg-accent-50 px-3 py-1 text-xs font-medium text-accent-700">Figma</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <span class="text-sm font-semibold text-green-600">LKR 45,000</span>
          <span class="text-xs text-gray-400">Graphic Design</span>
        </div>
      </div>

      <div class="card">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-green-100 text-sm font-bold text-green-700">KD</div>
          <div>
            <div class="font-semibold text-gray-900">Sinhala Content Writer</div>
            <div class="text-xs text-gray-400">Posted 1 day ago</div>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Seeking a native Sinhala writer for blog posts, social media content, and marketing materials for a local business.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-700">Sinhala</span>
          <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-700">SEO</span>
          <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-700">Blog</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <span class="text-sm font-semibold text-green-600">LKR 25,000</span>
          <span class="text-xs text-gray-400">Content Writing</span>
        </div>
      </div>

      <div class="card">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-yellow-100 text-sm font-bold text-yellow-700">RM</div>
          <div>
            <div class="font-semibold text-gray-900">Social Media Marketing</div>
            <div class="text-xs text-gray-400">Posted 3 days ago</div>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Looking for a digital marketing specialist to manage social media accounts and run targeted ad campaigns.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full bg-yellow-50 px-3 py-1 text-xs font-medium text-yellow-700">Facebook Ads</span>
          <span class="rounded-full bg-yellow-50 px-3 py-1 text-xs font-medium text-yellow-700">Instagram</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <span class="text-sm font-semibold text-green-600">LKR 60,000/mo</span>
          <span class="text-xs text-gray-400">Digital Marketing</span>
        </div>
      </div>

      <div class="card">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-purple-100 text-sm font-bold text-purple-700">NF</div>
          <div>
            <div class="font-semibold text-gray-900">Mobile App Development</div>
            <div class="text-xs text-gray-400">Posted 4 days ago</div>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Build a cross-platform mobile app for a food delivery service in Kandy. Must support Sinhala and Tamil.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full bg-purple-50 px-3 py-1 text-xs font-medium text-purple-700">Flutter</span>
          <span class="rounded-full bg-purple-50 px-3 py-1 text-xs font-medium text-purple-700">Firebase</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <span class="text-sm font-semibold text-green-600">LKR 300,000</span>
          <span class="text-xs text-gray-400">Web Development</span>
        </div>
      </div>

      <div class="card">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-red-100 text-sm font-bold text-red-700">SP</div>
          <div>
            <div class="font-semibold text-gray-900">Video Editor for YouTube</div>
            <div class="text-xs text-gray-400">Posted 1 week ago</div>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Looking for a skilled video editor to produce weekly YouTube content. Must have experience with motion graphics.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-medium text-red-700">Premiere Pro</span>
          <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-medium text-red-700">After Effects</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <span class="text-sm font-semibold text-green-600">LKR 35,000/mo</span>
          <span class="text-xs text-gray-400">Video & Animation</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
