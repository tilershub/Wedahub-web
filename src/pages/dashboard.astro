---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard" description="Your වැඩHUB dashboard">
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div id="dashboard-loading" class="py-20 text-center text-gray-400">Loading dashboard...</div>

    <div id="dashboard-content" class="hidden">
      <div class="rounded-xl bg-gradient-to-r from-gray-900 to-brand-900 p-5 text-white shadow-lg sm:p-8">
        <h1 class="text-xl font-bold sm:text-2xl" id="welcome-msg">Welcome back!</h1>
        <p class="mt-1 text-sm text-gray-300 sm:text-base" id="role-msg">Manage your activity on වැඩHUB.</p>
      </div>

      <!-- Stats: Homeowner -->
      <div id="stats-homeowner" class="mt-6 grid grid-cols-2 gap-3 sm:mt-8 sm:gap-6 lg:grid-cols-4">
        <div class="card !p-4 sm:!p-6">
          <div class="text-xs font-medium text-gray-500 sm:text-sm">My Projects</div>
          <div class="mt-1 text-2xl font-bold text-gray-900 sm:mt-2 sm:text-3xl">0</div>
        </div>
        <div class="card !p-4 sm:!p-6">
          <div class="text-xs font-medium text-gray-500 sm:text-sm">Quotes Received</div>
          <div class="mt-1 text-2xl font-bold text-gray-900 sm:mt-2 sm:text-3xl">0</div>
        </div>
        <div class="card !p-4 sm:!p-6">
          <div class="text-xs font-medium text-gray-500 sm:text-sm">Total Spent</div>
          <div class="mt-1 text-2xl font-bold text-gray-900 sm:mt-2 sm:text-3xl">LKR 0</div>
        </div>
        <div class="card !p-4 sm:!p-6">
          <div class="text-xs font-medium text-gray-500 sm:text-sm">Reviews Given</div>
          <div class="mt-1 text-2xl font-bold text-gray-900 sm:mt-2 sm:text-3xl">0</div>
        </div>
      </div>

      <!-- Stats: Professional -->
      <div id="stats-professional" class="mt-6 hidden grid-cols-2 gap-3 sm:mt-8 sm:gap-6 lg:grid-cols-4">
        <div class="card !p-4 sm:!p-6">
          <div class="text-xs font-medium text-gray-500 sm:text-sm">My Projects</div>
          <div class="mt-1 text-2xl font-bold text-gray-900 sm:mt-2 sm:text-3xl">0</div>
        </div>
        <div class="card !p-4 sm:!p-6">
          <div class="text-xs font-medium text-gray-500 sm:text-sm">Quotes Sent</div>
          <div class="mt-1 text-2xl font-bold text-gray-900 sm:mt-2 sm:text-3xl">0</div>
        </div>
        <div class="card !p-4 sm:!p-6">
          <div class="text-xs font-medium text-gray-500 sm:text-sm">Total Earned</div>
          <div class="mt-1 text-2xl font-bold text-gray-900 sm:mt-2 sm:text-3xl">LKR 0</div>
        </div>
        <div class="card !p-4 sm:!p-6">
          <div class="text-xs font-medium text-gray-500 sm:text-sm">My Rating</div>
          <div class="mt-1 text-2xl font-bold text-gray-900 sm:mt-2 sm:text-3xl">--</div>
        </div>
      </div>

      <!-- Quick Actions: Homeowner -->
      <div id="actions-homeowner" class="mt-6 sm:mt-8">
        <h2 class="text-base font-semibold text-gray-900 sm:text-lg">Quick Actions</h2>
        <div class="mt-3 grid gap-3 sm:mt-4 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
          <a href="/post" class="card flex items-center gap-3 !p-4 hover:border-brand-300 active:bg-gray-50 sm:gap-4 sm:!p-6">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-lg sm:h-12 sm:w-12 sm:text-xl">📋</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-gray-900 sm:text-base">Post a Project</div>
              <div class="text-xs text-gray-500 sm:text-sm">Get free quotes from pros</div>
            </div>
          </a>
          <a href="/professionals" class="card flex items-center gap-3 !p-4 hover:border-brand-300 active:bg-gray-50 sm:gap-4 sm:!p-6">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-green-100 text-lg sm:h-12 sm:w-12 sm:text-xl">🔍</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-gray-900 sm:text-base">Find Professionals</div>
              <div class="text-xs text-gray-500 sm:text-sm">Browse verified contractors</div>
            </div>
          </a>
          <a href="/projects" class="card flex items-center gap-3 !p-4 hover:border-brand-300 active:bg-gray-50 sm:gap-4 sm:!p-6">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-100 text-lg sm:h-12 sm:w-12 sm:text-xl">🏠</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-gray-900 sm:text-base">Browse Projects</div>
              <div class="text-xs text-gray-500 sm:text-sm">Get inspired by recent work</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Quick Actions: Professional -->
      <div id="actions-professional" class="mt-6 hidden sm:mt-8">
        <h2 class="text-base font-semibold text-gray-900 sm:text-lg">Quick Actions</h2>
        <div class="mt-3 grid gap-3 sm:mt-4 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
          <a href="/pro/profile" class="card flex items-center gap-3 !p-4 hover:border-brand-300 active:bg-gray-50 sm:gap-4 sm:!p-6">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-lg sm:h-12 sm:w-12 sm:text-xl">⚙️</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-gray-900 sm:text-base">My Business Profile</div>
              <div class="text-xs text-gray-500 sm:text-sm">Set up company, services & areas</div>
            </div>
          </a>
          <a href="/pro/add-project" class="card flex items-center gap-3 !p-4 hover:border-brand-300 active:bg-gray-50 sm:gap-4 sm:!p-6">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-lg sm:h-12 sm:w-12 sm:text-xl">📸</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-gray-900 sm:text-base">Add New Project</div>
              <div class="text-xs text-gray-500 sm:text-sm">Add your construction project</div>
            </div>
          </a>
          <a href="/pro/projects" class="card flex items-center gap-3 !p-4 hover:border-brand-300 active:bg-gray-50 sm:gap-4 sm:!p-6">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-green-100 text-lg sm:h-12 sm:w-12 sm:text-xl">📂</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-gray-900 sm:text-base">Manage My Projects</div>
              <div class="text-xs text-gray-500 sm:text-sm">View, edit & manage projects</div>
            </div>
          </a>
          <a href="/projects" class="card flex items-center gap-3 !p-4 hover:border-brand-300 active:bg-gray-50 sm:gap-4 sm:!p-6">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-purple-100 text-lg sm:h-12 sm:w-12 sm:text-xl">📋</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-gray-900 sm:text-base">Browse Requests</div>
              <div class="text-xs text-gray-500 sm:text-sm">Find projects & send quotes</div>
            </div>
          </a>
          <a href="/professionals" class="card flex items-center gap-3 !p-4 hover:border-brand-300 active:bg-gray-50 sm:gap-4 sm:!p-6">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-100 text-lg sm:h-12 sm:w-12 sm:text-xl">👤</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-gray-900 sm:text-base">My Public Profile</div>
              <div class="text-xs text-gray-500 sm:text-sm">View how clients see you</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="mt-8">
        <h2 class="text-lg font-semibold text-gray-900">Recent Activity</h2>
        <div class="mt-4 card text-center py-12">
          <div class="text-4xl">🏗️</div>
          <p class="mt-3 text-gray-400" id="empty-msg">No recent activity yet.</p>
          <a href="/post" id="empty-cta" class="btn-primary mt-4 inline-block">Post a Project</a>
        </div>
      </div>
    </div>

    <!-- Not authenticated -->
    <div id="dashboard-unauthenticated" class="hidden py-20 text-center">
      <div class="text-5xl">🔐</div>
      <h2 class="mt-4 text-2xl font-bold text-gray-900">Please log in</h2>
      <p class="mt-2 text-gray-500">You need to be logged in to access your dashboard.</p>
      <div class="mt-6 flex items-center justify-center gap-4">
        <a href="/login" class="btn-primary">Log In</a>
        <a href="/register" class="btn-secondary">Create Account</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const loading = document.getElementById('dashboard-loading')!;
  const content = document.getElementById('dashboard-content')!;
  const unauthenticated = document.getElementById('dashboard-unauthenticated')!;
  const welcomeMsg = document.getElementById('welcome-msg')!;
  const roleMsg = document.getElementById('role-msg')!;

  async function init() {
    const { data: { user } } = await supabase.auth.getUser();
    loading.classList.add('hidden');

    if (!user) {
      unauthenticated.classList.remove('hidden');
      return;
    }

    const { data: profileResponse } = await supabase.functions.invoke('get-profile');
    const profile = profileResponse?.profile;

    const name = profile?.full_name || user.user_metadata?.full_name || user.email;
    const role = profile?.role || user.user_metadata?.role || 'homeowner';
    const isPro = role === 'professional';

    welcomeMsg.textContent = `Welcome back, ${name}!`;
    roleMsg.textContent = isPro
      ? 'Manage your projects, quotes, and client connections.'
      : 'Manage your projects and connect with professionals.';

    // Show role-specific sections
    if (isPro) {
      document.getElementById('stats-homeowner')!.classList.add('hidden');
      const statsPro = document.getElementById('stats-professional')!;
      statsPro.classList.remove('hidden');
      statsPro.classList.add('grid');
      document.getElementById('actions-homeowner')!.classList.add('hidden');
      document.getElementById('actions-professional')!.classList.remove('hidden');
      document.getElementById('empty-msg')!.textContent = 'No recent activity yet. Add your first project!';
      const cta = document.getElementById('empty-cta')!;
      cta.textContent = 'Add New Project';
      cta.setAttribute('href', '/pro/add-project');
    }

    content.classList.remove('hidden');
  }

  init();
</script>
