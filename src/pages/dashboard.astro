---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard" description="Your වැඩHUB dashboard">
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div id="dashboard-loading" class="py-20 text-center text-gray-400">Loading dashboard...</div>

    <div id="dashboard-content" class="hidden">
      <div class="rounded-xl bg-gradient-to-r from-gray-900 to-brand-900 p-8 text-white shadow-lg">
        <h1 class="text-2xl font-bold" id="welcome-msg">Welcome back!</h1>
        <p class="mt-1 text-gray-300">Manage your projects and connect with professionals on වැඩHUB.</p>
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card">
          <div class="text-sm font-medium text-gray-500">Active Projects</div>
          <div class="mt-2 text-3xl font-bold text-gray-900">0</div>
        </div>
        <div class="card">
          <div class="text-sm font-medium text-gray-500">Quotes Received</div>
          <div class="mt-2 text-3xl font-bold text-gray-900">0</div>
        </div>
        <div class="card">
          <div class="text-sm font-medium text-gray-500">Total Spent</div>
          <div class="mt-2 text-3xl font-bold text-gray-900">LKR 0</div>
        </div>
        <div class="card">
          <div class="text-sm font-medium text-gray-500">Reviews Given</div>
          <div class="mt-2 text-3xl font-bold text-gray-900">0</div>
        </div>
      </div>

      <div class="mt-8">
        <h2 class="text-lg font-semibold text-gray-900">Quick Actions</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/post" class="card flex items-center gap-4 hover:border-brand-300">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-brand-100 text-xl">📋</div>
            <div>
              <div class="font-semibold text-gray-900">Post a Project</div>
              <div class="text-sm text-gray-500">Get free quotes from pros</div>
            </div>
          </a>
          <a href="/professionals" class="card flex items-center gap-4 hover:border-brand-300">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-green-100 text-xl">🔍</div>
            <div>
              <div class="font-semibold text-gray-900">Find Professionals</div>
              <div class="text-sm text-gray-500">Browse verified contractors</div>
            </div>
          </a>
          <a href="/projects" class="card flex items-center gap-4 hover:border-brand-300">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-accent-100 text-xl">🏠</div>
            <div>
              <div class="font-semibold text-gray-900">Browse Projects</div>
              <div class="text-sm text-gray-500">Get inspired by recent work</div>
            </div>
          </a>
        </div>
      </div>

      <div class="mt-8">
        <h2 class="text-lg font-semibold text-gray-900">Recent Activity</h2>
        <div class="mt-4 card text-center py-12">
          <div class="text-4xl">🏗️</div>
          <p class="mt-3 text-gray-400">No recent activity yet. Start by posting your first project!</p>
          <a href="/post" class="btn-primary mt-4 inline-block">Post a Project</a>
        </div>
      </div>
    </div>

    <div id="dashboard-unauthenticated" class="hidden py-20 text-center">
      <div class="text-5xl">🔐</div>
      <h2 class="mt-4 text-2xl font-bold text-gray-900">Please log in</h2>
      <p class="mt-2 text-gray-500">You need to be logged in to access your dashboard.</p>
      <div class="mt-6 flex items-center justify-center gap-4">
        <a href="/login" class="btn-primary">Log In</a>
        <a href="/register" class="btn-secondary">Create Account</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const loading = document.getElementById('dashboard-loading')!;
  const content = document.getElementById('dashboard-content')!;
  const unauthenticated = document.getElementById('dashboard-unauthenticated')!;
  const welcomeMsg = document.getElementById('welcome-msg')!;

  async function init() {
    const { data: { user } } = await supabase.auth.getUser();
    loading.classList.add('hidden');
    if (user) {
      const name = user.user_metadata?.full_name || user.email;
      welcomeMsg.textContent = `Welcome back, ${name}!`;
      content.classList.remove('hidden');
    } else {
      unauthenticated.classList.remove('hidden');
    }
  }

  init();
</script>
