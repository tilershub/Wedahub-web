---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabaseClient';

let status: 'Connected' | 'Not connected' = 'Not connected';
let errorMessage: string | null = null;
let providersData: unknown[] | null = null;

const { data, error } = await supabase.from('providers').select('*').limit(5);

if (error) {
  const message = error.message || 'Unknown Supabase error.';
  const likelyConnected = !/fetch failed|failed to fetch|network|invalid url|url is required/i.test(message);

  status = likelyConnected ? 'Connected' : 'Not connected';
  errorMessage = likelyConnected
    ? `Supabase connection works, but the "providers" table and/or RLS policy may be missing. Supabase message: ${message}`
    : `Could not connect to Supabase. Message: ${message}`;
} else {
  status = 'Connected';
  providersData = data ?? [];
}
---

<BaseLayout title="Supabase Test - වැඩHUB">
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <h1 class="text-3xl font-bold mb-6">Supabase Connectivity Test</h1>

    <section class="bg-white shadow rounded-xl p-6 space-y-4">
      <p class="text-lg">
        <strong>Status:</strong>
        <span class={status === 'Connected' ? 'text-green-600 font-semibold' : 'text-red-600 font-semibold'}>
          {status}
        </span>
      </p>

      {errorMessage && (
        <p class="text-amber-700 bg-amber-50 border border-amber-200 rounded p-3">
          <strong>Message:</strong> {errorMessage}
        </p>
      )}

      {providersData && (
        <div>
          <h2 class="text-xl font-semibold mb-2">providers query result</h2>
          <pre class="bg-gray-900 text-green-200 p-4 rounded overflow-x-auto text-sm">{JSON.stringify(providersData, null, 2)}</pre>
        </div>
      )}
    </section>
  </main>
</BaseLayout>
