---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Learn about වැඩHUB and our mission to empower Sri Lankan freelancers">
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">About වැඩHUB</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-500">
        Empowering Sri Lankan talent and connecting them with opportunities.
      </p>
    </div>

    <div class="mt-16 space-y-12">
      <div class="card">
        <h2 class="text-2xl font-bold text-gray-900">Our Mission</h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          වැඩHUB (WedaHUB) is Sri Lanka's homegrown freelance platform, built to bridge
          the gap between talented professionals and businesses that need them. Our name
          comes from the Sinhala word "වැඩ" (weda), meaning "work" — because that's exactly
          what we're here to help you find and deliver.
        </p>
        <p class="mt-4 text-gray-600 leading-relaxed">
          We believe that Sri Lanka has an abundance of skilled individuals — developers,
          designers, writers, marketers, and more — who deserve a dedicated platform that
          understands local needs, supports local payment methods, and champions local talent.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        <div class="card text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-brand-100 text-2xl">
            🎯
          </div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">Local Focus</h3>
          <p class="mt-2 text-sm text-gray-500">
            Built specifically for the Sri Lankan market with local payment support and
            Sinhala/Tamil language options.
          </p>
        </div>
        <div class="card text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-green-100 text-2xl">
            🤝
          </div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">Fair & Transparent</h3>
          <p class="mt-2 text-sm text-gray-500">
            Low platform fees, escrow-protected payments, and a transparent review system
            for both clients and freelancers.
          </p>
        </div>
        <div class="card text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-accent-100 text-2xl">
            🚀
          </div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">Growth Oriented</h3>
          <p class="mt-2 text-sm text-gray-500">
            Resources, community events, and skill-building opportunities to help
            freelancers grow their careers.
          </p>
        </div>
      </div>

      <div class="card">
        <h2 class="text-2xl font-bold text-gray-900">How It Works</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">1</div>
            <h3 class="mt-3 font-semibold text-gray-900">Create Your Profile</h3>
            <p class="mt-1 text-sm text-gray-500">Sign up and showcase your skills, portfolio, and experience.</p>
          </div>
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">2</div>
            <h3 class="mt-3 font-semibold text-gray-900">Find or Post Work</h3>
            <p class="mt-1 text-sm text-gray-500">Browse gigs or post your project to find the right match.</p>
          </div>
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">3</div>
            <h3 class="mt-3 font-semibold text-gray-900">Get Paid Securely</h3>
            <p class="mt-1 text-sm text-gray-500">Complete the work and receive secure payment through our platform.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
