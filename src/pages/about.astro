---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Learn about වැඩHUB, Sri Lanka's trusted construction services marketplace">
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">About වැඩHUB</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-500">
        Sri Lanka's trusted marketplace for construction services and home improvement professionals.
      </p>
    </div>

    <div class="mt-16 space-y-12">
      <div class="card">
        <h2 class="text-2xl font-bold text-gray-900">Our Mission</h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          වැඩHUB (WedaHUB) is Sri Lanka's dedicated construction services marketplace — built
          to connect homeowners with trusted, verified construction professionals. Our name
          comes from the Sinhala word "වැඩ" (weda), meaning "work" — because quality workmanship
          is the foundation of every great building project.
        </p>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Whether you're building your dream home, renovating a kitchen, fixing a leaky roof,
          or designing a garden, වැඩHUB makes it easy to find the right professional. Think of
          us as Sri Lanka's answer to Houzz — a place where homeowners discover, hire, and
          collaborate with the best builders, architects, plumbers, electricians, and tradespeople
          across the island.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        <div class="card text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-brand-100 text-2xl">🔍</div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">Verified Pros</h3>
          <p class="mt-2 text-sm text-gray-500">
            Every professional is verified — we check licenses, review portfolios, and confirm identities before they join.
          </p>
        </div>
        <div class="card text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-green-100 text-2xl">🤝</div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">Transparent Pricing</h3>
          <p class="mt-2 text-sm text-gray-500">
            Get multiple competitive quotes, compare budgets, and pay securely through milestone-based payments.
          </p>
        </div>
        <div class="card text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-accent-100 text-2xl">🏗️</div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">End-to-End Support</h3>
          <p class="mt-2 text-sm text-gray-500">
            From finding the right pro to managing the project and payments — we're with you every step.
          </p>
        </div>
      </div>

      <div class="card">
        <h2 class="text-2xl font-bold text-gray-900">How It Works</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">1</div>
            <h3 class="mt-3 font-semibold text-gray-900">Describe Your Project</h3>
            <p class="mt-1 text-sm text-gray-500">Tell us what you need — new build, renovation, repair, or any home improvement.</p>
          </div>
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">2</div>
            <h3 class="mt-3 font-semibold text-gray-900">Get Free Quotes</h3>
            <p class="mt-1 text-sm text-gray-500">Receive competitive quotes from verified professionals near you.</p>
          </div>
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">3</div>
            <h3 class="mt-3 font-semibold text-gray-900">Hire the Right Pro</h3>
            <p class="mt-1 text-sm text-gray-500">Compare portfolios, ratings, and prices. Choose the best fit.</p>
          </div>
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">4</div>
            <h3 class="mt-3 font-semibold text-gray-900">Build with Confidence</h3>
            <p class="mt-1 text-sm text-gray-500">Track milestones, pay securely, and leave a review when done.</p>
          </div>
        </div>
      </div>

      <div class="card bg-gray-50">
        <h2 class="text-2xl font-bold text-gray-900">By the Numbers</h2>
        <div class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-4">
          <div class="text-center">
            <div class="text-3xl font-bold text-brand-600">3,500+</div>
            <div class="mt-1 text-sm text-gray-500">Verified Professionals</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-brand-600">12,000+</div>
            <div class="mt-1 text-sm text-gray-500">Projects Completed</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-brand-600">25+</div>
            <div class="mt-1 text-sm text-gray-500">Districts Covered</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-brand-600">4.8/5</div>
            <div class="mt-1 text-sm text-gray-500">Average Rating</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
