---
import BaseLayout from '../../layouts/BaseLayout.astro';

const serviceCategories = [
  'General Construction',
  'Architecture & Design',
  'Interior Design',
  'Plumbing',
  'Electrical Work',
  'Masonry & Tiling',
  'Carpentry & Woodwork',
  'Painting & Finishing',
  'Roofing',
  'Landscaping',
  'Welding & Metalwork',
  'Waterproofing',
  'Other',
];

const projectTypes = [
  'New Build',
  'Renovation',
  'Repair',
  'Extension',
  'Interior Design',
  'Landscaping',
  'Restoration',
];

const districts = [
  'Colombo', 'Gampaha', 'Kalutara', 'Kandy', 'Matale', 'Nuwara Eliya',
  'Galle', 'Matara', 'Hambantota', 'Jaffna', 'Kilinochchi', 'Mannar',
  'Vavuniya', 'Mullaitivu', 'Batticaloa', 'Ampara', 'Trincomalee',
  'Kurunegala', 'Puttalam', 'Anuradhapura', 'Polonnaruwa', 'Badulla',
  'Monaragala', 'Ratnapura', 'Kegalle',
];
---

<BaseLayout title="Edit Project" description="Edit your project on වැඩHUB">
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <div id="edit-loading" class="py-20 text-center text-gray-400">Loading project...</div>

    <div id="edit-not-found" class="hidden py-20 text-center">
      <div class="text-5xl">🔍</div>
      <h2 class="mt-4 text-2xl font-bold text-gray-900">Project Not Found</h2>
      <p class="mt-2 text-gray-500">This project doesn't exist or you don't have permission to edit it.</p>
      <a href="/pro/projects" class="btn-primary mt-6 inline-block">Back to My Projects</a>
    </div>

    <div id="edit-content" class="hidden">
      <div class="flex items-center justify-between">
        <div>
          <div class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">Edit Project</div>
          <h1 class="mt-3 text-3xl font-bold text-gray-900">Edit Project</h1>
          <p class="mt-1 text-gray-500">Update your project details and photos</p>
        </div>
        <a href="/pro/projects" class="btn-secondary text-sm">Back to Projects</a>
      </div>

      <form id="edit-form" class="mt-8 space-y-6">
        <!-- Project Info -->
        <div class="card space-y-5">
          <h2 class="text-lg font-semibold text-gray-900">Project Information</h2>

          <div>
            <label for="title" class="block text-sm font-medium text-gray-700">Project Title</label>
            <input type="text" id="title" name="title" required class="input-field mt-1" />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="category" class="block text-sm font-medium text-gray-700">Service Category</label>
              <select id="category" name="category" required class="input-field mt-1">
                <option value="">Select category</option>
                {serviceCategories.map((cat) => (
                  <option value={cat}>{cat}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="project-type" class="block text-sm font-medium text-gray-700">Project Type</label>
              <select id="project-type" name="project_type" required class="input-field mt-1">
                <option value="">Select type</option>
                {projectTypes.map((type) => (
                  <option value={type}>{type}</option>
                ))}
              </select>
            </div>
          </div>

          <div>
            <label for="description" class="block text-sm font-medium text-gray-700">Project Description</label>
            <textarea id="description" name="description" required rows="5" class="input-field mt-1 resize-y"></textarea>
          </div>
        </div>

        <!-- Location & Details -->
        <div class="card space-y-5">
          <h2 class="text-lg font-semibold text-gray-900">Location & Details</h2>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="district" class="block text-sm font-medium text-gray-700">District</label>
              <select id="district" name="district" required class="input-field mt-1">
                <option value="">Select district</option>
                {districts.map((d) => (
                  <option value={d}>{d}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="area" class="block text-sm font-medium text-gray-700">Area / City</label>
              <input type="text" id="area" name="area" class="input-field mt-1" />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-3">
            <div>
              <label for="cost" class="block text-sm font-medium text-gray-700">Project Cost (LKR)</label>
              <input type="number" id="cost" name="cost" min="0" class="input-field mt-1" />
            </div>
            <div>
              <label for="duration" class="block text-sm font-medium text-gray-700">Duration</label>
              <input type="text" id="duration" name="duration" class="input-field mt-1" />
            </div>
            <div>
              <label for="year" class="block text-sm font-medium text-gray-700">Year Completed</label>
              <input type="number" id="year" name="year_completed" min="2000" max="2026" class="input-field mt-1" />
            </div>
          </div>

          <div>
            <label for="tags" class="block text-sm font-medium text-gray-700">Tags</label>
            <input type="text" id="tags" name="tags" placeholder="Comma separated" class="input-field mt-1" />
          </div>
        </div>

        <!-- Existing Photos -->
        <div class="card space-y-5">
          <h2 class="text-lg font-semibold text-gray-900">Photos</h2>
          <div id="existing-photos" class="space-y-2">
            <!-- Populated by JS -->
          </div>

          <h3 class="text-sm font-medium text-gray-700">Add More Photos</h3>
          <div class="space-y-3" id="photo-fields">
            <div class="flex gap-3">
              <input type="url" name="new_photos[]" placeholder="Photo URL" class="input-field flex-1" />
              <select name="new_photo_types[]" class="input-field w-32">
                <option value="after">After</option>
                <option value="before">Before</option>
                <option value="during">During</option>
              </select>
            </div>
          </div>
          <button type="button" id="add-photo-btn" class="text-sm font-medium text-brand-600 hover:text-brand-700">
            + Add another photo
          </button>
        </div>

        <div id="edit-error" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600"></div>
        <div id="edit-success" class="hidden rounded-lg bg-green-50 p-3 text-sm text-green-600"></div>

        <div class="flex gap-4">
          <button type="submit" class="btn-primary">Save Changes</button>
          <a href="/pro/projects" class="btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';

  const loading = document.getElementById('edit-loading')!;
  const content = document.getElementById('edit-content')!;
  const notFound = document.getElementById('edit-not-found')!;
  const form = document.getElementById('edit-form') as HTMLFormElement;
  const errorEl = document.getElementById('edit-error') as HTMLDivElement;
  const successEl = document.getElementById('edit-success') as HTMLDivElement;
  const existingPhotos = document.getElementById('existing-photos')!;
  const addBtn = document.getElementById('add-photo-btn');
  const photoFields = document.getElementById('photo-fields');

  const params = new URLSearchParams(window.location.search);
  const projectId = params.get('id');

  addBtn?.addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'flex gap-3';
    row.innerHTML = `
      <input type="url" name="new_photos[]" placeholder="Photo URL" class="input-field flex-1" />
      <select name="new_photo_types[]" class="input-field w-32">
        <option value="after">After</option>
        <option value="before">Before</option>
        <option value="during">During</option>
      </select>
    `;
    photoFields?.appendChild(row);
  });

  async function init() {
    if (!projectId) {
      loading.classList.add('hidden');
      notFound.classList.remove('hidden');
      return;
    }

    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      loading.classList.add('hidden');
      notFound.classList.remove('hidden');
      return;
    }

    // Fetch the project
    const { data: project, error } = await supabase
      .from('portfolio_projects')
      .select('*, project_photos(*)')
      .eq('id', projectId)
      .eq('professional_id', user.id)
      .single();

    loading.classList.add('hidden');

    if (error || !project) {
      notFound.classList.remove('hidden');
      return;
    }

    // Populate form fields
    (document.getElementById('title') as HTMLInputElement).value = project.title;
    (document.getElementById('category') as HTMLSelectElement).value = project.category;
    (document.getElementById('project-type') as HTMLSelectElement).value = project.project_type;
    (document.getElementById('description') as HTMLTextAreaElement).value = project.description;
    (document.getElementById('district') as HTMLSelectElement).value = project.district;
    (document.getElementById('area') as HTMLInputElement).value = project.area || '';
    (document.getElementById('cost') as HTMLInputElement).value = project.cost?.toString() || '';
    (document.getElementById('duration') as HTMLInputElement).value = project.duration || '';
    (document.getElementById('year') as HTMLInputElement).value = project.year_completed?.toString() || '';
    (document.getElementById('tags') as HTMLInputElement).value = (project.tags || []).join(', ');

    // Render existing photos
    const photos = project.project_photos || [];
    if (photos.length > 0) {
      existingPhotos.innerHTML = photos.map((photo: any) => `
        <div class="flex items-center gap-3 rounded-lg border border-gray-200 p-3" data-photo-id="${photo.id}">
          <div class="h-12 w-12 flex-shrink-0 overflow-hidden rounded-lg bg-gray-100">
            <img src="${photo.photo_url}" alt="" class="h-full w-full object-cover" onerror="this.parentElement.innerHTML='📷'" />
          </div>
          <div class="flex-1 truncate text-sm text-gray-600">${photo.photo_url}</div>
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">${photo.is_before ? 'Before' : photo.caption || 'After'}</span>
          <button type="button" onclick="removePhoto('${photo.id}')" class="text-sm text-red-500 hover:text-red-700">Remove</button>
        </div>
      `).join('');
    } else {
      existingPhotos.innerHTML = '<p class="text-sm text-gray-400">No photos added yet.</p>';
    }

    content.classList.remove('hidden');
  }

  // Global function for photo removal
  (window as any).removePhoto = async (photoId: string) => {
    const { error } = await supabase.from('project_photos').delete().eq('id', photoId);
    if (!error) {
      const el = document.querySelector(`[data-photo-id="${photoId}"]`);
      el?.remove();
    }
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    const { data: { user } } = await supabase.auth.getUser();
    if (!user || !projectId) return;

    const formData = new FormData(form);
    const tags = (formData.get('tags') as string)?.split(',').map(t => t.trim()).filter(Boolean) || [];

    // Update portfolio project
    const { error } = await supabase
      .from('portfolio_projects')
      .update({
        title: formData.get('title'),
        description: formData.get('description'),
        category: formData.get('category'),
        project_type: formData.get('project_type'),
        district: formData.get('district'),
        area: formData.get('area') || null,
        cost: Number(formData.get('cost')) || null,
        duration: formData.get('duration') || null,
        year_completed: Number(formData.get('year_completed')) || null,
        tags,
        updated_at: new Date().toISOString(),
      })
      .eq('id', projectId)
      .eq('professional_id', user.id);

    if (error) {
      errorEl.textContent = error.message;
      errorEl.classList.remove('hidden');
      return;
    }

    // Insert new photos
    const newPhotos = formData.getAll('new_photos[]') as string[];
    const newPhotoTypes = formData.getAll('new_photo_types[]') as string[];
    const validPhotos = newPhotos
      .map((url, i) => ({ url, type: newPhotoTypes[i] || 'after' }))
      .filter(p => p.url.trim());

    if (validPhotos.length > 0) {
      await supabase.from('project_photos').insert(
        validPhotos.map(p => ({
          project_id: null,
          portfolio_project_id: projectId,
          professional_id: user.id,
          photo_url: p.url,
          is_before: p.type === 'before',
          caption: p.type,
        }))
      );
    }

    successEl.textContent = 'Project updated successfully!';
    successEl.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  init();
</script>
