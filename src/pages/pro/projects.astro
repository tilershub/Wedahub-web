---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="My Projects" description="Manage your projects on වැඩHUB">
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div id="page-loading" class="py-20 text-center text-gray-400">Loading projects...</div>

    <div id="page-unauthenticated" class="hidden py-20 text-center">
      <div class="text-5xl">🔐</div>
      <h2 class="mt-4 text-2xl font-bold text-gray-900">Professional Account Required</h2>
      <p class="mt-2 text-gray-500">Log in with your professional account to manage your projects.</p>
      <div class="mt-6 flex items-center justify-center gap-4">
        <a href="/login" class="btn-primary">Log In</a>
        <a href="/register" class="btn-secondary">Register as Pro</a>
      </div>
    </div>

    <div id="page-content" class="hidden">
      <!-- Header -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">My Projects</div>
          <h1 class="mt-3 text-3xl font-bold text-gray-900">My Projects</h1>
          <p class="mt-1 text-gray-500">Manage your construction projects</p>
        </div>
        <a href="/pro/add-project" class="btn-primary inline-flex items-center gap-2 self-start">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Add New Project
        </a>
      </div>

      <!-- Stats Summary -->
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="card">
          <div class="text-sm font-medium text-gray-500">Total Projects</div>
          <div class="mt-1 text-2xl font-bold text-gray-900" id="stat-total">0</div>
        </div>
        <div class="card">
          <div class="text-sm font-medium text-gray-500">Featured</div>
          <div class="mt-1 text-2xl font-bold text-brand-600" id="stat-featured">0</div>
        </div>
        <div class="card">
          <div class="text-sm font-medium text-gray-500">Total Photos</div>
          <div class="mt-1 text-2xl font-bold text-gray-900" id="stat-photos">0</div>
        </div>
      </div>

      <!-- Project List -->
      <div class="mt-8" id="projects-list">
        <!-- Populated by JS -->
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="mt-8 hidden">
        <div class="card py-16 text-center">
          <div class="text-5xl">📸</div>
          <h3 class="mt-4 text-xl font-semibold text-gray-900">No projects yet</h3>
          <p class="mt-2 text-gray-500">Add your construction projects to attract homeowners.</p>
          <a href="/pro/add-project" class="btn-primary mt-6 inline-block">Add Your First Project</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Delete Confirmation Modal -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-black/50" id="delete-modal-backdrop"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
      <div class="relative w-full max-w-md rounded-xl bg-white p-6 shadow-xl">
        <h3 class="text-lg font-semibold text-gray-900">Delete Project</h3>
        <p class="mt-2 text-sm text-gray-500">Are you sure you want to delete this project? This action cannot be undone. All associated photos will also be removed.</p>
        <div class="mt-6 flex justify-end gap-3">
          <button id="delete-cancel" class="btn-secondary text-sm">Cancel</button>
          <button id="delete-confirm" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">Delete Project</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';

  const loading = document.getElementById('page-loading')!;
  const content = document.getElementById('page-content')!;
  const unauthenticated = document.getElementById('page-unauthenticated')!;
  const projectsList = document.getElementById('projects-list')!;
  const emptyState = document.getElementById('empty-state')!;
  const deleteModal = document.getElementById('delete-modal')!;
  const deleteCancel = document.getElementById('delete-cancel')!;
  const deleteConfirm = document.getElementById('delete-confirm')!;
  const deleteBackdrop = document.getElementById('delete-modal-backdrop')!;

  let deleteProjectId: string | null = null;

  function formatCost(cost: number | null): string {
    if (!cost) return '—';
    return `LKR ${cost.toLocaleString()}`;
  }

  function renderProject(project: any): string {
    const tags = (project.tags || []).slice(0, 3);
    const photoCount = project.project_photos?.length || 0;

    return `
      <div class="card mb-4" data-project-id="${project.id}">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-lg font-semibold text-gray-900">${project.title}</h3>
              ${project.is_featured ? '<span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">Featured</span>' : ''}
            </div>
            <div class="mt-1 flex flex-wrap gap-3 text-sm text-gray-500">
              <span>${project.category}</span>
              <span>&middot;</span>
              <span>${project.district}</span>
              ${project.year_completed ? `<span>&middot;</span><span>${project.year_completed}</span>` : ''}
            </div>
            <p class="mt-2 line-clamp-2 text-sm text-gray-600">${project.description}</p>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              ${tags.map((t: string) => `<span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">${t}</span>`).join('')}
              <span class="text-xs text-gray-400">${photoCount} photo${photoCount !== 1 ? 's' : ''}</span>
              ${project.cost ? `<span class="text-xs font-medium text-brand-600">${formatCost(project.cost)}</span>` : ''}
              ${project.duration ? `<span class="text-xs text-gray-400">${project.duration}</span>` : ''}
            </div>
          </div>
          <div class="flex gap-2 self-start">
            <a href="/pro/edit-project?id=${project.id}" class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-600 hover:border-brand-300 hover:text-brand-600">Edit</a>
            <button onclick="openDeleteModal('${project.id}')" class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm font-medium text-red-500 hover:border-red-300 hover:bg-red-50">Delete</button>
          </div>
        </div>
      </div>
    `;
  }

  // Make openDeleteModal available globally for onclick handlers
  (window as any).openDeleteModal = (id: string) => {
    deleteProjectId = id;
    deleteModal.classList.remove('hidden');
  };

  function closeDeleteModal() {
    deleteProjectId = null;
    deleteModal.classList.add('hidden');
  }

  deleteCancel.addEventListener('click', closeDeleteModal);
  deleteBackdrop.addEventListener('click', closeDeleteModal);

  deleteConfirm.addEventListener('click', async () => {
    if (!deleteProjectId) return;

    // Delete photos first, then portfolio project
    await supabase.from('project_photos').delete().eq('portfolio_project_id', deleteProjectId);
    const { error } = await supabase.from('portfolio_projects').delete().eq('id', deleteProjectId);

    if (error) {
      alert('Failed to delete project: ' + error.message);
    } else {
      // Remove from DOM
      const card = document.querySelector(`[data-project-id="${deleteProjectId}"]`);
      card?.remove();

      // Update stats
      const remaining = projectsList.querySelectorAll('[data-project-id]').length;
      document.getElementById('stat-total')!.textContent = remaining.toString();
      if (remaining === 0) {
        emptyState.classList.remove('hidden');
      }
    }

    closeDeleteModal();
  });

  async function init() {
    const { data: { user } } = await supabase.auth.getUser();
    loading.classList.add('hidden');

    if (!user || user.user_metadata?.role !== 'professional') {
      unauthenticated.classList.remove('hidden');
      return;
    }

    // Fetch portfolio projects with photos
    const { data: projects, error } = await supabase
      .from('portfolio_projects')
      .select('*, project_photos(*)')
      .eq('professional_id', user.id)
      .order('created_at', { ascending: false });

    if (error) {
      projectsList.innerHTML = `<div class="card text-center py-8 text-red-500">Failed to load projects: ${error.message}</div>`;
      content.classList.remove('hidden');
      return;
    }

    // Update stats
    const total = projects?.length || 0;
    const featured = projects?.filter(p => p.is_featured).length || 0;
    const photos = projects?.reduce((sum, p) => sum + (p.project_photos?.length || 0), 0) || 0;

    document.getElementById('stat-total')!.textContent = total.toString();
    document.getElementById('stat-featured')!.textContent = featured.toString();
    document.getElementById('stat-photos')!.textContent = photos.toString();

    if (total === 0) {
      emptyState.classList.remove('hidden');
    } else {
      projectsList.innerHTML = projects!.map(renderProject).join('');
    }

    content.classList.remove('hidden');
  }

  init();
</script>
