---
import BaseLayout from '../layouts/BaseLayout.astro';

const projectTypes = ['All', 'New Build', 'Renovation', 'Kitchen', 'Bathroom', 'Landscaping', 'Interior Design', 'Roofing', 'Extension', 'Restoration'];
---

<BaseLayout title="Projects" description="Browse completed construction and renovation projects across Sri Lanka for inspiration">
  <section class="mx-auto max-w-7xl px-4 py-6 sm:py-10 sm:px-6 lg:px-8">
    <!-- Page Header with tabs -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">Projects</h1>
        <p class="mt-1 text-sm text-gray-500 sm:text-base">Explore completed work and active project requests</p>
      </div>
      <div class="flex gap-2">
        <a href="/pro/add-project" class="btn-primary text-sm">Add Project</a>
      </div>
    </div>

    <!-- Tab Switcher -->
    <div class="mt-5 border-b border-gray-200 sm:mt-8">
      <div class="flex gap-4 sm:gap-6">
        <button id="tab-portfolio" class="border-b-2 border-brand-600 pb-2.5 text-sm font-semibold text-brand-600 sm:pb-3">
          Pro Projects
        </button>
        <button id="tab-requests" class="border-b-2 border-transparent pb-2.5 text-sm font-medium text-gray-500 hover:text-gray-700 sm:pb-3">
          Project Requests
        </button>
      </div>
    </div>

    <!-- PRO PROJECTS TAB: Projects added by professionals -->
    <div id="panel-portfolio">
      <p class="mt-6 text-sm text-gray-400">Projects include both provider portfolio work and all-in-one solutions such as bathroom and kitchen projects.</p>

      <!-- Type Filter -->
      <div class="mt-4 -mx-4 px-4 sm:mx-0 sm:px-0">
        <div class="scroll-x gap-2 pb-1 sm:flex-wrap">
          {projectTypes.map((type, i) => (
            <button
              class:list={[
                'shrink-0 rounded-full px-3 py-2 text-xs font-medium transition-colors sm:px-4 sm:text-sm',
                i === 0 ? 'bg-brand-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200',
              ]}
            >
              {type}
            </button>
          ))}
        </div>
      </div>

      <div class="mt-4 grid gap-4 sm:mt-6 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
        <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
          <div class="aspect-video bg-gradient-to-br from-brand-100 to-brand-200 p-6 flex items-center justify-center">
            <span class="text-6xl">🏠</span>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">New Build</span>
              <span class="text-xs text-gray-400">Colombo 7</span>
            </div>
            <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Modern Two-Story Family Home</h3>
            <p class="mt-1 text-sm text-gray-500">3,200 sq ft contemporary home with open floor plan, 4 bedrooms, and a rooftop terrace.</p>
            <div class="mt-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">SR</div>
                <span class="text-xs text-gray-500">Sampath Rajapaksa</span>
              </div>
              <span class="text-sm font-semibold text-gray-600">LKR 18M</span>
            </div>
          </div>
        </div>

        <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
          <div class="aspect-video bg-gradient-to-br from-amber-100 to-amber-200 p-6 flex items-center justify-center">
            <span class="text-6xl">🍳</span>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700">Kitchen</span>
              <span class="text-xs text-gray-400">Kandy</span>
            </div>
            <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Modern Kitchen Renovation</h3>
            <p class="mt-1 text-sm text-gray-500">Complete kitchen remodel with granite countertops, custom cabinetry, and modern appliances.</p>
            <div class="mt-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-pink-100 text-xs font-bold text-pink-700">MW</div>
                <span class="text-xs text-gray-500">Malini Wickramasinghe</span>
              </div>
              <span class="text-sm font-semibold text-gray-600">LKR 2.5M</span>
            </div>
          </div>
        </div>

        <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
          <div class="aspect-video bg-gradient-to-br from-blue-100 to-blue-200 p-6 flex items-center justify-center">
            <span class="text-6xl">🚿</span>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700">Bathroom</span>
              <span class="text-xs text-gray-400">Gampaha</span>
            </div>
            <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Luxury Bathroom Upgrade</h3>
            <p class="mt-1 text-sm text-gray-500">Master bathroom with walk-in rain shower, freestanding tub, and imported Italian tiles.</p>
            <div class="mt-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-100 text-xs font-bold text-blue-700">KP</div>
                <span class="text-xs text-gray-500">Kamal Perera</span>
              </div>
              <span class="text-sm font-semibold text-gray-600">LKR 1.8M</span>
            </div>
          </div>
        </div>

        <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
          <div class="aspect-video bg-gradient-to-br from-green-100 to-green-200 p-6 flex items-center justify-center">
            <span class="text-6xl">🌿</span>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700">Landscaping</span>
              <span class="text-xs text-gray-400">Negombo</span>
            </div>
            <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Tropical Garden & Pool Design</h3>
            <p class="mt-1 text-sm text-gray-500">Full landscape with infinity pool, tropical plantings, stone pathways, and outdoor entertainment area.</p>
            <div class="mt-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-700">AS</div>
                <span class="text-xs text-gray-500">Asanka Silva</span>
              </div>
              <span class="text-sm font-semibold text-gray-600">LKR 4.5M</span>
            </div>
          </div>
        </div>

        <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
          <div class="aspect-video bg-gradient-to-br from-purple-100 to-purple-200 p-6 flex items-center justify-center">
            <span class="text-6xl">🏗️</span>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700">Restoration</span>
              <span class="text-xs text-gray-400">Galle Fort</span>
            </div>
            <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Heritage Building Restoration</h3>
            <p class="mt-1 text-sm text-gray-500">Colonial-era building restoration preserving heritage architecture while modernizing interiors.</p>
            <div class="mt-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-accent-100 text-xs font-bold text-accent-700">NF</div>
                <span class="text-xs text-gray-500">Nirosha Fernando</span>
              </div>
              <span class="text-sm font-semibold text-gray-600">LKR 12M</span>
            </div>
          </div>
        </div>

        <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
          <div class="aspect-video bg-gradient-to-br from-yellow-100 to-orange-200 p-6 flex items-center justify-center">
            <span class="text-6xl">⚡</span>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-yellow-50 px-2.5 py-0.5 text-xs font-medium text-yellow-700">Electrical</span>
              <span class="text-xs text-gray-400">Colombo 5</span>
            </div>
            <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Whole-Home Solar Installation</h3>
            <p class="mt-1 text-sm text-gray-500">10kW rooftop solar system with battery backup, smart inverter, and net metering setup.</p>
            <div class="mt-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-yellow-100 text-xs font-bold text-yellow-700">DA</div>
                <span class="text-xs text-gray-500">Dinesh Abeysekara</span>
              </div>
              <span class="text-sm font-semibold text-gray-600">LKR 3.2M</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- REQUESTS TAB: Homeowner project requests seeking quotes -->
    <div id="panel-requests" class="hidden">
      <p class="mt-6 text-sm text-gray-400">Active project requests from homeowners looking for professionals</p>
      <div id="requests-grid" class="mt-4 grid gap-4 sm:mt-6 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
        <!-- Populated by JS -->
      </div>
      <div id="requests-empty" class="hidden mt-8 card py-12 text-center">
        <div class="text-4xl">📋</div>
        <p class="mt-3 text-gray-500">No open project requests yet.</p>
        <a href="/post" class="btn-primary mt-4 inline-block">Post a Project</a>
      </div>
      <div id="requests-cta" class="hidden mt-8 text-center">
        <p class="text-sm text-gray-500">Are you a professional? Send quotes to these projects to win work.</p>
        <a href="/register" class="btn-primary mt-3 inline-block">Join as a Pro</a>
      </div>
    </div>
  </section>

  <!-- Send Quote Modal (for professionals) -->
  <div id="quote-modal" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-black/50" id="quote-modal-backdrop"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
      <div class="relative w-full max-w-lg rounded-xl bg-white p-6 shadow-xl">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-gray-900">Send a Quote</h3>
          <button id="quote-modal-close" class="text-gray-400 hover:text-gray-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <p class="mt-1 text-sm text-gray-500" id="quote-project-title"></p>

        <form id="quote-form" class="mt-5 space-y-4">
          <div>
            <label for="quote-amount" class="block text-sm font-medium text-gray-700">Your Quote Amount (LKR)</label>
            <input type="number" id="quote-amount" min="1" required placeholder="e.g. 500000" class="input-field mt-1" />
          </div>
          <div>
            <label for="quote-description" class="block text-sm font-medium text-gray-700">Description</label>
            <textarea id="quote-description" rows="4" required placeholder="Describe your approach, what's included, and why you're the right fit for this project." class="input-field mt-1 resize-y"></textarea>
          </div>
          <div>
            <label for="quote-duration" class="block text-sm font-medium text-gray-700">Estimated Duration</label>
            <input type="text" id="quote-duration" placeholder="e.g. 3-4 weeks" class="input-field mt-1" />
          </div>
          <label class="flex cursor-pointer items-center gap-2">
            <input type="checkbox" id="quote-materials" class="h-4 w-4 rounded border-gray-300 text-brand-600" />
            <span class="text-sm text-gray-700">Materials included in quote</span>
          </label>

          <div id="quote-error" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600"></div>
          <div id="quote-success" class="hidden rounded-lg bg-green-50 p-3 text-sm text-green-600"></div>

          <div class="flex gap-3 pt-1">
            <button type="submit" class="btn-primary flex-1">Submit Quote</button>
            <button type="button" id="quote-cancel" class="btn-secondary">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const tabPortfolio = document.getElementById('tab-portfolio')!;
  const tabRequests = document.getElementById('tab-requests')!;
  const panelPortfolio = document.getElementById('panel-portfolio')!;
  const panelRequests = document.getElementById('panel-requests')!;

  function activate(activeTab: HTMLElement, inactiveTab: HTMLElement, activePanel: HTMLElement, inactivePanel: HTMLElement) {
    activeTab.className = 'border-b-2 border-brand-600 pb-3 text-sm font-semibold text-brand-600';
    inactiveTab.className = 'border-b-2 border-transparent pb-3 text-sm font-medium text-gray-500 hover:text-gray-700';
    activePanel.classList.remove('hidden');
    inactivePanel.classList.add('hidden');
  }

  tabPortfolio.addEventListener('click', () => activate(tabPortfolio, tabRequests, panelPortfolio, panelRequests));
  tabRequests.addEventListener('click', () => activate(tabRequests, tabPortfolio, panelRequests, panelPortfolio));

  function escapeHtml(str: string): string {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Load real data from Supabase
  async function loadProjects() {
    try {
      const { supabase } = await import('../lib/supabase');

      const { data: portfolioProjects } = await supabase
        .from('portfolio_projects')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(12);

      if (portfolioProjects && portfolioProjects.length > 0) {
        const grid = panelPortfolio.querySelector('.grid');
        if (!grid) return;
        const colors = [
          { bg: 'from-brand-100 to-brand-200', badge: 'bg-brand-50 text-brand-700' },
          { bg: 'from-amber-100 to-amber-200', badge: 'bg-amber-50 text-amber-700' },
          { bg: 'from-blue-100 to-blue-200', badge: 'bg-blue-50 text-blue-700' },
          { bg: 'from-green-100 to-green-200', badge: 'bg-green-50 text-green-700' },
          { bg: 'from-purple-100 to-purple-200', badge: 'bg-purple-50 text-purple-700' },
          { bg: 'from-yellow-100 to-orange-200', badge: 'bg-yellow-50 text-yellow-700' },
        ];
        const emojis = ['🏠', '🍳', '🚿', '🌿', '🏗️', '⚡'];
        grid.innerHTML = portfolioProjects.map((p, i) => {
          const c = colors[i % colors.length];
          const emoji = emojis[i % emojis.length];
          const cost = p.cost ? `LKR ${(p.cost / 1000000).toFixed(1)}M` : '';
          return `
            <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm hover:shadow-md">
              <div class="flex h-44 items-center justify-center bg-gradient-to-br ${c.bg} sm:aspect-video sm:h-auto">
                <span class="text-5xl sm:text-6xl">${emoji}</span>
              </div>
              <div class="p-5">
                <div class="flex items-center gap-2">
                  <span class="rounded-full ${c.badge} px-2.5 py-0.5 text-xs font-medium">${escapeHtml(p.project_type || p.category || 'Project')}</span>
                  <span class="text-xs text-gray-400">${escapeHtml(p.district || '')}</span>
                </div>
                <h3 class="mt-2 font-semibold text-gray-900">${escapeHtml(p.title)}</h3>
                <p class="mt-1 text-sm text-gray-500">${escapeHtml((p.description || '').slice(0, 120))}</p>
                ${cost ? `<div class="mt-3"><span class="text-sm font-semibold text-gray-600">${cost}</span></div>` : ''}
              </div>
            </div>`;
        }).join('');
      }

      const { data: requests } = await supabase
        .from('projects')
        .select('*')
        .eq('status', 'open')
        .order('created_at', { ascending: false })
        .limit(20);

      const requestsGrid = document.getElementById('requests-grid')!;
      const requestsEmpty = document.getElementById('requests-empty')!;
      const requestsCta = document.getElementById('requests-cta')!;

      if (requests && requests.length > 0) {
        requestsGrid.innerHTML = requests.map(r => {
          const budget = r.budget_min && r.budget_max
            ? `LKR ${Number(r.budget_min).toLocaleString()} – ${Number(r.budget_max).toLocaleString()}`
            : r.budget_min ? `From LKR ${Number(r.budget_min).toLocaleString()}` : '';
          const daysAgo = Math.floor((Date.now() - new Date(r.created_at).getTime()) / 86400000);
          const posted = daysAgo === 0 ? 'Today' : daysAgo === 1 ? 'Yesterday' : `${daysAgo} days ago`;
          return `
            <div class="card flex flex-col">
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-700">Open</span>
              </div>
              <h3 class="mt-3 font-semibold text-gray-900">${escapeHtml(r.title)}</h3>
              <p class="mt-1 text-sm text-gray-500 flex-1">${escapeHtml((r.description || '').slice(0, 150))}${(r.description || '').length > 150 ? '…' : ''}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                ${r.category ? `<span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">${escapeHtml(r.category)}</span>` : ''}
                ${r.project_type ? `<span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600">${escapeHtml(r.project_type)}</span>` : ''}
              </div>
              <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3">
                <span class="text-xs text-gray-400">${escapeHtml(r.location || '')} &bull; ${posted}</span>
                ${budget ? `<span class="text-sm font-semibold text-green-600">${budget}</span>` : ''}
              </div>
              <button onclick="openQuoteModal('${r.id}', '${escapeHtml(r.title.replace(/'/g, "\\'"))}')" class="quote-btn mt-3 hidden w-full rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Send Quote</button>
            </div>`;
        }).join('');

        // Show send quote buttons only for professionals
        const { data: { user } } = await supabase.auth.getUser();
        if (user && user.user_metadata?.role === 'professional') {
          document.querySelectorAll('.quote-btn').forEach(btn => btn.classList.remove('hidden'));
        } else if (!user) {
          requestsCta.classList.remove('hidden');
        }
      } else {
        requestsEmpty.classList.remove('hidden');
      }
    } catch (err) {
      console.error('Failed to load projects from Supabase:', err);
    }
  }

  // Quote modal
  let activeProjectId = '';

  (window as any).openQuoteModal = (projectId: string, title: string) => {
    activeProjectId = projectId;
    document.getElementById('quote-project-title')!.textContent = title;
    document.getElementById('quote-error')!.classList.add('hidden');
    document.getElementById('quote-success')!.classList.add('hidden');
    (document.getElementById('quote-form') as HTMLFormElement).reset();
    document.getElementById('quote-modal')!.classList.remove('hidden');
  };

  function closeQuoteModal() {
    document.getElementById('quote-modal')!.classList.add('hidden');
    activeProjectId = '';
  }

  document.getElementById('quote-modal-close')?.addEventListener('click', closeQuoteModal);
  document.getElementById('quote-cancel')?.addEventListener('click', closeQuoteModal);
  document.getElementById('quote-modal-backdrop')?.addEventListener('click', closeQuoteModal);

  document.getElementById('quote-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errorEl = document.getElementById('quote-error')!;
    const successEl = document.getElementById('quote-success')!;
    errorEl.classList.add('hidden');

    const { supabase: sb } = await import('../lib/supabase');
    const { data: { user } } = await sb.auth.getUser();
    if (!user) { errorEl.textContent = 'Please log in first.'; errorEl.classList.remove('hidden'); return; }

    const amount = Number((document.getElementById('quote-amount') as HTMLInputElement).value);
    const description = (document.getElementById('quote-description') as HTMLTextAreaElement).value.trim();
    const duration = (document.getElementById('quote-duration') as HTMLInputElement).value.trim();
    const materialsIncluded = (document.getElementById('quote-materials') as HTMLInputElement).checked;

    const { error } = await sb.from('quotes').insert({
      project_id: activeProjectId,
      professional_id: user.id,
      amount,
      description,
      estimated_duration: duration || null,
      materials_included: materialsIncluded,
    });

    if (error) {
      errorEl.textContent = error.message.includes('unique') ? 'You have already sent a quote for this project.' : error.message;
      errorEl.classList.remove('hidden');
    } else {
      successEl.textContent = 'Quote sent successfully! The homeowner will review it soon.';
      successEl.classList.remove('hidden');
      setTimeout(closeQuoteModal, 2000);
    }
  });

  loadProjects();
</script>
