---
import BaseLayout from '../layouts/BaseLayout.astro';

const projectTypes = ['All', 'New Build', 'Renovation', 'Kitchen', 'Bathroom', 'Landscaping', 'Interior Design', 'Roofing', 'Extension'];
---

<BaseLayout title="Projects" description="Browse completed construction and renovation projects across Sri Lanka for inspiration">
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Project Gallery</h1>
      <p class="mt-1 text-gray-500">Browse completed projects for ideas and inspiration</p>
    </div>

    <!-- Type Filter -->
    <div class="mt-8 flex flex-wrap gap-2">
      {projectTypes.map((type, i) => (
        <button
          class:list={[
            'rounded-full px-4 py-2 text-sm font-medium transition-colors',
            i === 0
              ? 'bg-brand-600 text-white'
              : 'bg-gray-100 text-gray-600 hover:bg-gray-200',
          ]}
        >
          {type}
        </button>
      ))}
    </div>

    <!-- Projects Grid -->
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

      <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
        <div class="aspect-video bg-gradient-to-br from-brand-100 to-brand-200 p-6 flex items-center justify-center">
          <span class="text-6xl">🏠</span>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">New Build</span>
            <span class="text-xs text-gray-400">Colombo 7</span>
          </div>
          <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Modern Two-Story Family Home</h3>
          <p class="mt-1 text-sm text-gray-500">A 3,200 sq ft contemporary home with open floor plan, 4 bedrooms, and a rooftop terrace overlooking the garden.</p>
          <div class="mt-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">SR</div>
              <span class="text-xs text-gray-500">by Sampath Rajapaksa</span>
            </div>
            <span class="text-sm font-semibold text-gray-600">LKR 18M</span>
          </div>
        </div>
      </div>

      <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
        <div class="aspect-video bg-gradient-to-br from-amber-100 to-amber-200 p-6 flex items-center justify-center">
          <span class="text-6xl">🍳</span>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700">Kitchen</span>
            <span class="text-xs text-gray-400">Kandy</span>
          </div>
          <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Modern Kitchen Renovation</h3>
          <p class="mt-1 text-sm text-gray-500">Complete kitchen remodel with granite countertops, custom cabinetry, island, and modern appliance integration.</p>
          <div class="mt-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="flex h-7 w-7 items-center justify-center rounded-full bg-pink-100 text-xs font-bold text-pink-700">MW</div>
              <span class="text-xs text-gray-500">by Malini Wickramasinghe</span>
            </div>
            <span class="text-sm font-semibold text-gray-600">LKR 2.5M</span>
          </div>
        </div>
      </div>

      <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
        <div class="aspect-video bg-gradient-to-br from-blue-100 to-blue-200 p-6 flex items-center justify-center">
          <span class="text-6xl">🚿</span>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700">Bathroom</span>
            <span class="text-xs text-gray-400">Gampaha</span>
          </div>
          <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Luxury Bathroom Upgrade</h3>
          <p class="mt-1 text-sm text-gray-500">Master bathroom renovation with walk-in rain shower, freestanding tub, heated floors, and imported Italian tiles.</p>
          <div class="mt-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-100 text-xs font-bold text-blue-700">KP</div>
              <span class="text-xs text-gray-500">by Kamal Perera</span>
            </div>
            <span class="text-sm font-semibold text-gray-600">LKR 1.8M</span>
          </div>
        </div>
      </div>

      <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
        <div class="aspect-video bg-gradient-to-br from-green-100 to-green-200 p-6 flex items-center justify-center">
          <span class="text-6xl">🌿</span>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700">Landscaping</span>
            <span class="text-xs text-gray-400">Negombo</span>
          </div>
          <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Tropical Garden & Pool Design</h3>
          <p class="mt-1 text-sm text-gray-500">Full landscape design featuring an infinity pool, tropical plantings, stone pathways, and outdoor entertainment area.</p>
          <div class="mt-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="flex h-7 w-7 items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-700">AS</div>
              <span class="text-xs text-gray-500">by Asanka Silva</span>
            </div>
            <span class="text-sm font-semibold text-gray-600">LKR 4.5M</span>
          </div>
        </div>
      </div>

      <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
        <div class="aspect-video bg-gradient-to-br from-purple-100 to-purple-200 p-6 flex items-center justify-center">
          <span class="text-6xl">🏗️</span>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700">Renovation</span>
            <span class="text-xs text-gray-400">Galle Fort</span>
          </div>
          <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Heritage Building Restoration</h3>
          <p class="mt-1 text-sm text-gray-500">Careful restoration of a colonial-era building in Galle Fort, preserving heritage architecture while modernizing interiors.</p>
          <div class="mt-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="flex h-7 w-7 items-center justify-center rounded-full bg-accent-100 text-xs font-bold text-accent-700">NF</div>
              <span class="text-xs text-gray-500">by Nirosha Fernando</span>
            </div>
            <span class="text-sm font-semibold text-gray-600">LKR 12M</span>
          </div>
        </div>
      </div>

      <div class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
        <div class="aspect-video bg-gradient-to-br from-yellow-100 to-orange-200 p-6 flex items-center justify-center">
          <span class="text-6xl">⚡</span>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-yellow-50 px-2.5 py-0.5 text-xs font-medium text-yellow-700">Electrical</span>
            <span class="text-xs text-gray-400">Colombo 5</span>
          </div>
          <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-brand-600">Whole-Home Solar Installation</h3>
          <p class="mt-1 text-sm text-gray-500">10kW rooftop solar panel system with battery backup, smart inverter, and net metering setup for complete energy independence.</p>
          <div class="mt-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="flex h-7 w-7 items-center justify-center rounded-full bg-yellow-100 text-xs font-bold text-yellow-700">DA</div>
              <span class="text-xs text-gray-500">by Dinesh Abeysekara</span>
            </div>
            <span class="text-sm font-semibold text-gray-600">LKR 3.2M</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
