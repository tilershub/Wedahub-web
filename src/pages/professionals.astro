---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  'All',
  'General Contractors',
  'Architects',
  'Interior Designers',
  'Plumbing',
  'Electrical Work',
  'Masonry & Tiling',
  'Carpentry',
  'Painting',
  'Roofing',
  'Landscaping',
  'Welding & Metalwork',
  'Waterproofing',
];

const districts = [
  'All Districts',
  'Colombo',
  'Gampaha',
  'Kandy',
  'Galle',
  'Matara',
  'Kurunegala',
  'Ratnapura',
  'Jaffna',
  'Anuradhapura',
  'Badulla',
];
---

<BaseLayout title="Find Professionals" description="Find verified construction professionals, contractors, and home improvement experts across Sri Lanka">
  <section class="mx-auto max-w-7xl px-4 py-6 sm:py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 sm:gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">Find Professionals</h1>
        <p class="mt-1 text-sm text-gray-500 sm:text-base">Verified construction professionals across Sri Lanka</p>
      </div>
      <div class="flex gap-3">
        <select class="input-field w-full sm:w-48" id="district-filter">
          {districts.map((d) => (
            <option value={d}>{d}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Service Filter -->
    <div class="mt-5 -mx-4 px-4 sm:mx-0 sm:mt-8 sm:px-0">
      <div class="scroll-x gap-2 pb-1 sm:flex-wrap">
        {services.map((svc, i) => (
          <button
            class:list={[
              'shrink-0 rounded-full px-3 py-2 text-xs font-medium transition-colors sm:px-4 sm:text-sm',
              i === 0
                ? 'bg-brand-600 text-white'
                : 'bg-gray-100 text-gray-600 hover:bg-gray-200',
            ]}
            data-service={svc}
          >
            {svc}
          </button>
        ))}
      </div>
    </div>

    <!-- Professionals Grid -->
    <div class="mt-5 grid gap-4 sm:mt-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">

      <!-- Pro Card: Contractor -->
      <div class="card">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xl font-bold text-brand-700">SR</div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="font-semibold text-gray-900">Sampath Rajapaksa</h3>
              <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Verified</span>
            </div>
            <p class="text-sm text-brand-600">General Construction, Roofing, Masonry & Tiling</p>
            <p class="text-xs text-gray-400">Colombo, Western Province</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          15+ years building residential homes and commercial properties. Specializing in modern house construction and luxury villas.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">General Construction</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Roofing</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Masonry & Tiling</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <div class="flex items-center gap-1">
            <span class="text-sm font-semibold text-yellow-500">4.9</span>
            <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-xs text-gray-400">(127 reviews)</span>
          </div>
          <span class="text-sm font-semibold text-gray-600">48 projects</span>
        </div>
      </div>

      <!-- Pro Card: Architect -->
      <div class="card">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent-100 text-xl font-bold text-accent-700">NF</div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="font-semibold text-gray-900">Nirosha Fernando</h3>
              <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Verified</span>
            </div>
            <p class="text-sm text-accent-600">Architecture & Design, Interior Design</p>
            <p class="text-xs text-gray-400">Kandy, Central Province</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Award-winning architect blending modern design with traditional Sri Lankan elements. SLIA certified with expertise in sustainable architecture.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Architecture & Design</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Interior Design</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <div class="flex items-center gap-1">
            <span class="text-sm font-semibold text-yellow-500">4.8</span>
            <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-xs text-gray-400">(89 reviews)</span>
          </div>
          <span class="text-sm font-semibold text-gray-600">35 projects</span>
        </div>
      </div>

      <!-- Pro Card: Plumber -->
      <div class="card">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-blue-100 text-xl font-bold text-blue-700">KP</div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="font-semibold text-gray-900">Kamal Perera</h3>
              <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Verified</span>
            </div>
            <p class="text-sm text-blue-600">Plumbing, Waterproofing</p>
            <p class="text-xs text-gray-400">Gampaha, Western Province</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Licensed plumber with 20 years experience. Expert in bathroom installations, water systems, drainage, and emergency plumbing repairs.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Plumbing</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Waterproofing</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <div class="flex items-center gap-1">
            <span class="text-sm font-semibold text-yellow-500">4.7</span>
            <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-xs text-gray-400">(203 reviews)</span>
          </div>
          <span class="text-sm font-semibold text-gray-600">312 projects</span>
        </div>
      </div>

      <!-- Pro Card: Electrician -->
      <div class="card">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-yellow-100 text-xl font-bold text-yellow-700">DA</div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="font-semibold text-gray-900">Dinesh Abeysekara</h3>
              <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Verified</span>
            </div>
            <p class="text-sm text-yellow-600">Electrical Work, Roofing</p>
            <p class="text-xs text-gray-400">Colombo, Western Province</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          CEB-certified electrician specializing in residential wiring, solar panel installation, smart home systems, and industrial electrical work.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Electrical Work</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Roofing</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <div class="flex items-center gap-1">
            <span class="text-sm font-semibold text-yellow-500">4.9</span>
            <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-xs text-gray-400">(156 reviews)</span>
          </div>
          <span class="text-sm font-semibold text-gray-600">185 projects</span>
        </div>
      </div>

      <!-- Pro Card: Interior Designer -->
      <div class="card">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-pink-100 text-xl font-bold text-pink-700">MW</div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="font-semibold text-gray-900">Malini Wickramasinghe</h3>
              <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Verified</span>
            </div>
            <p class="text-sm text-pink-600">Interior Design, Painting & Finishing, Carpentry & Woodwork</p>
            <p class="text-xs text-gray-400">Colombo, Western Province</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Transforming spaces with contemporary Sri Lankan aesthetics. Specializing in living rooms, kitchens, and full home interior makeovers.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Interior Design</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Painting & Finishing</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Carpentry & Woodwork</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <div class="flex items-center gap-1">
            <span class="text-sm font-semibold text-yellow-500">5.0</span>
            <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-xs text-gray-400">(72 reviews)</span>
          </div>
          <span class="text-sm font-semibold text-gray-600">28 projects</span>
        </div>
      </div>

      <!-- Pro Card: Mason -->
      <div class="card">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-orange-100 text-xl font-bold text-orange-700">RJ</div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="font-semibold text-gray-900">Ruwan Jayawardena</h3>
              <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Verified</span>
            </div>
            <p class="text-sm text-orange-600">Masonry & Tiling, Landscaping, Waterproofing</p>
            <p class="text-xs text-gray-400">Galle, Southern Province</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Expert in brick and block work, tiling, plastering, and decorative stonework. Known for quality craftsmanship across Southern Province.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Masonry & Tiling</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Landscaping</span>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">Waterproofing</span>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
          <div class="flex items-center gap-1">
            <span class="text-sm font-semibold text-yellow-500">4.6</span>
            <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-xs text-gray-400">(94 reviews)</span>
          </div>
          <span class="text-sm font-semibold text-gray-600">145 projects</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
