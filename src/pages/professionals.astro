---

<BaseLayout title="Find Professionals" description="Find verified construction professionals across Sri Lanka">
  <section class="mx-auto max-w-7xl px-4 py-6 sm:py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 sm:gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-bold text-stone-900 sm:text-3xl">Find Professionals</h1>
        <p class="mt-1 text-sm text-stone-500 sm:text-base">Verified construction professionals across Sri Lanka</p>
      </div>
      <div class="flex gap-3">
        <select class="rounded-xl border border-stone-200 bg-white px-3 py-2 text-sm text-stone-700 outline-none focus:border-brand-400" id="district-filter">
          {districts.map((d) => <option value={d}>{d}</option>)}
        </select>
        <select class="rounded-xl border border-stone-200 bg-white px-3 py-2 text-sm text-stone-700 outline-none focus:border-brand-400" id="sort-filter">
          <option value="rating">Highest Rated</option>
          <option value="jobs">Most Jobs</option>
          <option value="experience">Most Experience</option>
        </select>
      </div>
    </div>

    <!-- Service Filter -->
    <div class="mt-5 -mx-4 px-4 sm:mx-0 sm:mt-8 sm:px-0">
      <div class="scroll-x gap-2 pb-1 sm:flex-wrap">
        {serviceList.map((svc, i) => (
          <button
            class:list={[
              'svc-btn shrink-0 rounded-full px-3 py-2 text-xs font-medium transition-colors sm:px-4 sm:text-sm',
              i === 0 ? 'bg-brand-600 text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200',
            ]}
            data-service={svc}
          >
            {svc}
          </button>
        ))}
      </div>
    </div>

    <!-- No results -->
    <div id="pros-empty" class="mt-8 hidden rounded-2xl border border-stone-200 bg-white py-12 text-center">
      <div class="text-4xl">🔍</div>
      <p class="mt-3 text-stone-500">No professionals found matching your filters.</p>
      <button id="reset-filters" class="mt-3 text-sm font-semibold text-brand-600 hover:text-brand-700">Clear filters</button>
    </div>

    <!-- Professionals Grid -->
    <div id="pros-grid" class="mt-5 grid gap-4 sm:mt-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {defaultPros.map((pro) => (
        <a href={`/provider?id=${pro.id}`} class="pro-card group rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-md" data-services={pro.services.join(',')} data-district={pro.district}>
          <div class="flex items-start gap-4">
            <div class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-full text-xl font-bold ${pro.color}`}>{pro.initials}</div>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="font-semibold text-stone-900 group-hover:text-brand-700">{pro.name}</h3>
                {pro.verified && <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Verified</span>}
              </div>
              <p class="text-xs text-stone-400">{pro.district}</p>
            </div>
          </div>
          <p class="mt-3 text-sm text-stone-500">{pro.bio}</p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {pro.services.map((s) => (
              <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-600">{s}</span>
            ))}
          </div>
          <div class="mt-4 flex items-center justify-between border-t border-stone-100 pt-4">
            <div class="flex items-center gap-1">
              <span class="text-sm font-semibold text-yellow-500">{pro.rating}</span>
              <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <span class="text-xs text-stone-400">({pro.reviews})</span>
            </div>
            <span class="text-sm font-semibold text-stone-600">{pro.projectCount} jobs</span>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <span class="rounded-xl border border-stone-200 py-2 text-center text-xs font-semibold text-stone-700">View Profile</span>
            <span class="rounded-xl bg-brand-600 py-2 text-center text-xs font-semibold text-white">Get Quote</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const grid = document.getElementById('pros-grid')!;
  const emptyState = document.getElementById('pros-empty')!;
  let cards = grid.querySelectorAll('.pro-card') as NodeListOf<HTMLElement>;
  const svcBtns = document.querySelectorAll('.svc-btn') as NodeListOf<HTMLButtonElement>;
  const districtFilter = document.getElementById('district-filter') as HTMLSelectElement;
  const sortFilter = document.getElementById('sort-filter') as HTMLSelectElement;
  const resetBtn = document.getElementById('reset-filters');

  let activeService = 'All';

  function applyFilters() {
    const district = districtFilter.value;
    let visible = 0;

    cards.forEach(card => {
      const cardServices = card.dataset.services || '';
      const cardDistrict = card.dataset.district || '';

      const matchesService = activeService === 'All' || cardServices.includes(activeService);
      const matchesDistrict = district === 'All Districts' || cardDistrict === district;

      if (matchesService && matchesDistrict) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    emptyState.classList.toggle('hidden', visible > 0);
  }

  svcBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      svcBtns.forEach(b => {
        b.classList.remove('bg-brand-600', 'text-white');
        b.classList.add('bg-stone-100', 'text-stone-600');
      });
      btn.classList.remove('bg-stone-100', 'text-stone-600');
      btn.classList.add('bg-brand-600', 'text-white');
      activeService = btn.dataset.service || 'All';
      applyFilters();
    });
  });

  districtFilter.addEventListener('change', applyFilters);
  sortFilter.addEventListener('change', applyFilters);

  resetBtn?.addEventListener('click', () => {
    activeService = 'All';
    districtFilter.value = 'All Districts';
    sortFilter.value = 'rating';
    svcBtns.forEach(b => {
      b.classList.remove('bg-brand-600', 'text-white');
      b.classList.add('bg-stone-100', 'text-stone-600');
    });
    svcBtns[0]?.classList.remove('bg-stone-100', 'text-stone-600');
    svcBtns[0]?.classList.add('bg-brand-600', 'text-white');
    applyFilters();
  });

  // Load real data from Supabase
  async function loadFromSupabase() {
    try {
      const { supabase } = await import('../lib/supabase');
      const { data: pros } = await supabase
        .from('professional_profiles')
        .select('id, company_name, service_categories, specializations, years_experience, completed_projects, average_rating, total_reviews, is_verified, service_areas')
        .order('average_rating', { ascending: false })
        .limit(30);

      if (!pros || pros.length === 0) return;

      const { data: profiles } = await supabase
        .from('profiles')
        .select('id, full_name, bio, district, avatar_url')
        .in('id', pros.map((p: any) => p.id));

      const profileMap = new Map((profiles || []).map((p: any) => [p.id, p]));
      const colors = ['bg-brand-100 text-brand-700', 'bg-accent-100 text-accent-700', 'bg-blue-100 text-blue-700', 'bg-yellow-100 text-yellow-700', 'bg-pink-100 text-pink-700', 'bg-orange-100 text-orange-700'];

      grid.innerHTML = pros.map((pro: any, i: number) => {
        const profile = profileMap.get(pro.id) as any;
        const name = pro.company_name || profile?.full_name || 'Professional';
        const initials = name.split(' ').slice(0, 2).map((w: string) => w[0]).join('');
        const svcs = pro.service_categories || [];
        const district = profile?.district || '';
        const bio = profile?.bio || '';
        const color = colors[i % colors.length];
        const rating = pro.average_rating ? pro.average_rating.toFixed(1) : 'New';

        return `
          <a href="/provider?id=${pro.id}" class="pro-card group rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-md" data-services="${svcs.join(',')}" data-district="${district}">
            <div class="flex items-start gap-4">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full text-xl font-bold ${color}">
                ${profile?.avatar_url ? `<img src="${profile.avatar_url}" class="h-14 w-14 rounded-full object-cover" />` : initials}
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h3 class="font-semibold text-stone-900 group-hover:text-brand-700">${name}</h3>
                  ${pro.is_verified ? '<span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Verified</span>' : ''}
                </div>
                <p class="text-xs text-stone-400">${district}</p>
              </div>
            </div>
            ${bio ? `<p class="mt-3 text-sm text-stone-500 line-clamp-2">${bio}</p>` : ''}
            <div class="mt-3 flex flex-wrap gap-1.5">
              ${svcs.slice(0, 3).map((s: string) => `<span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-600">${s}</span>`).join('')}
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-stone-100 pt-4">
              <div class="flex items-center gap-1">
                <span class="text-sm font-semibold text-yellow-500">${rating}</span>
                <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span class="text-xs text-stone-400">(${pro.total_reviews || 0})</span>
              </div>
              <span class="text-sm font-semibold text-stone-600">${pro.completed_projects || 0} jobs</span>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2">
              <span class="rounded-xl border border-stone-200 py-2 text-center text-xs font-semibold text-stone-700">View Profile</span>
              <span class="rounded-xl bg-brand-600 py-2 text-center text-xs font-semibold text-white">Get Quote</span>
            </div>
          </a>`;
      }).join('');

      // Re-bind card references after dynamic load
      cards = grid.querySelectorAll('.pro-card') as NodeListOf<HTMLElement>;
    } catch {
      // Supabase unavailable, keep hardcoded data
    }
  }

  loadFromSupabase();
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
