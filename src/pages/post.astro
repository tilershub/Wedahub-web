---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  'Web Development',
  'Graphic Design',
  'Content Writing',
  'Digital Marketing',
  'Video & Animation',
  'Translation',
  'Data Entry',
  'Photography',
  'Other',
];
---

<BaseLayout title="Post a Job" description="Post a new job on වැඩHUB and find skilled freelancers">
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Post a Job</h1>
      <p class="mt-1 text-gray-500">Describe your project and find the right freelancer</p>
    </div>

    <form id="post-form" class="mt-8 space-y-6">
      <div class="card space-y-5">
        <h2 class="text-lg font-semibold text-gray-900">Job Details</h2>

        <div>
          <label for="title" class="block text-sm font-medium text-gray-700">Job Title</label>
          <input
            type="text"
            id="title"
            name="title"
            required
            placeholder="e.g. Full-Stack Web Developer Needed"
            class="input-field mt-1"
          />
        </div>

        <div>
          <label for="category" class="block text-sm font-medium text-gray-700">Category</label>
          <select id="category" name="category" required class="input-field mt-1">
            <option value="">Select a category</option>
            {categories.map((cat) => (
              <option value={cat}>{cat}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="description" class="block text-sm font-medium text-gray-700">Description</label>
          <textarea
            id="description"
            name="description"
            required
            rows="6"
            placeholder="Describe your project requirements, goals, and expected deliverables..."
            class="input-field mt-1 resize-y"
          ></textarea>
        </div>

        <div>
          <label for="skills" class="block text-sm font-medium text-gray-700">Required Skills</label>
          <input
            type="text"
            id="skills"
            name="skills"
            placeholder="e.g. React, Node.js, PostgreSQL (comma separated)"
            class="input-field mt-1"
          />
        </div>
      </div>

      <div class="card space-y-5">
        <h2 class="text-lg font-semibold text-gray-900">Budget & Timeline</h2>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="budget" class="block text-sm font-medium text-gray-700">Budget (LKR)</label>
            <input
              type="number"
              id="budget"
              name="budget"
              required
              min="1000"
              placeholder="e.g. 50000"
              class="input-field mt-1"
            />
          </div>
          <div>
            <label for="budget-type" class="block text-sm font-medium text-gray-700">Budget Type</label>
            <select id="budget-type" name="budget_type" class="input-field mt-1">
              <option value="fixed">Fixed Price</option>
              <option value="hourly">Hourly Rate</option>
              <option value="monthly">Monthly</option>
            </select>
          </div>
        </div>

        <div>
          <label for="deadline" class="block text-sm font-medium text-gray-700">Deadline</label>
          <input
            type="date"
            id="deadline"
            name="deadline"
            class="input-field mt-1"
          />
        </div>
      </div>

      <div id="post-error" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600"></div>
      <div id="post-success" class="hidden rounded-lg bg-green-50 p-3 text-sm text-green-600"></div>

      <div class="flex gap-4">
        <button type="submit" class="btn-primary">
          Post Job
        </button>
        <a href="/gigs" class="btn-secondary">Cancel</a>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('post-form') as HTMLFormElement;
  const errorEl = document.getElementById('post-error') as HTMLDivElement;
  const successEl = document.getElementById('post-success') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      errorEl.textContent = 'You must be logged in to post a job.';
      errorEl.classList.remove('hidden');
      return;
    }

    const formData = new FormData(form);

    const { error } = await supabase.from('gigs').insert({
      title: formData.get('title'),
      category: formData.get('category'),
      description: formData.get('description'),
      skills: (formData.get('skills') as string)?.split(',').map((s) => s.trim()).filter(Boolean),
      budget: Number(formData.get('budget')),
      budget_type: formData.get('budget_type'),
      deadline: formData.get('deadline') || null,
      user_id: user.id,
    });

    if (error) {
      errorEl.textContent = error.message;
      errorEl.classList.remove('hidden');
    } else {
      successEl.textContent = 'Job posted successfully!';
      successEl.classList.remove('hidden');
      form.reset();
    }
  });
</script>
