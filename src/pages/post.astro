---
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceCategories = [
  'General Construction',
  'Architecture & Design',
  'Interior Design',
  'Plumbing',
  'Electrical Work',
  'Masonry',
  'Tiling',
  'Carpentry & Woodwork',
  'Glass Work',
  'Ceiling',
  'Pantry Cupboards',
  'Painting & Finishing',
  'Roofing',
  'Landscaping',
  'Welding & Metalwork',
  'Waterproofing',
  'YL Construction',
  'TILERSHUB',
  'Demolition',
  'Other',
];

const projectTypes = [
  'New Build',
  'Renovation',
  'Repair',
  'Extension',
  'Consultation',
];
---

<BaseLayout title="Get Quotes" description="Post your construction project and receive free quotes from verified professionals on වැඩHUB">
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Get Free Quotes</h1>
      <p class="mt-1 text-gray-500">Describe your project and receive quotes from verified professionals</p>
    </div>

    <form id="post-form" class="mt-8 space-y-6">
      <div class="card space-y-5">
        <h2 class="text-lg font-semibold text-gray-900">Project Details</h2>

        <div>
          <label for="title" class="block text-sm font-medium text-gray-700">Project Title</label>
          <input
            type="text"
            id="title"
            name="title"
            required
            placeholder="e.g. Two-Story House Construction in Colombo"
            class="input-field mt-1"
          />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="category" class="block text-sm font-medium text-gray-700">Service Needed</label>
            <select id="category" name="category" required class="input-field mt-1">
              <option value="">Select a service</option>
              {serviceCategories.map((cat) => (
                <option value={cat}>{cat}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="project-type" class="block text-sm font-medium text-gray-700">Project Type</label>
            <select id="project-type" name="project_type" required class="input-field mt-1">
              <option value="">Select type</option>
              {projectTypes.map((type) => (
                <option value={type}>{type}</option>
              ))}
            </select>
          </div>
        </div>

        <div>
          <label for="description" class="block text-sm font-medium text-gray-700">Project Description</label>
          <textarea
            id="description"
            name="description"
            required
            rows="6"
            placeholder="Describe your project in detail: What work needs to be done? What's the current state? Any specific materials or design preferences?"
            class="input-field mt-1 resize-y"
          ></textarea>
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-gray-700">Project Location</label>
          <input
            type="text"
            id="location"
            name="location"
            required
            placeholder="e.g. Colombo 7, Western Province"
            class="input-field mt-1"
          />
        </div>
      </div>

      <div class="card space-y-5">
        <h2 class="text-lg font-semibold text-gray-900">Budget & Timeline</h2>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="budget-min" class="block text-sm font-medium text-gray-700">Budget Range (LKR)</label>
            <div class="mt-1 flex gap-2">
              <input type="number" id="budget-min" name="budget_min" placeholder="Min" min="10000" class="input-field" />
              <span class="flex items-center text-gray-400">-</span>
              <input type="number" id="budget-max" name="budget_max" placeholder="Max" class="input-field" />
            </div>
          </div>
          <div>
            <label for="timeline" class="block text-sm font-medium text-gray-700">Expected Timeline</label>
            <select id="timeline" name="timeline" class="input-field mt-1">
              <option value="">Select timeline</option>
              <option value="urgent">Urgent (ASAP)</option>
              <option value="1-2-weeks">1-2 weeks</option>
              <option value="1-month">Within 1 month</option>
              <option value="1-3-months">1-3 months</option>
              <option value="3-6-months">3-6 months</option>
              <option value="6-12-months">6-12 months</option>
              <option value="flexible">Flexible</option>
            </select>
          </div>
        </div>

        <div>
          <label for="start-date" class="block text-sm font-medium text-gray-700">Preferred Start Date</label>
          <input type="date" id="start-date" name="start_date" class="input-field mt-1" />
        </div>
      </div>

      <div id="post-error" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600"></div>
      <div id="post-success" class="hidden rounded-lg bg-green-50 p-3 text-sm text-green-600"></div>

      <div class="flex gap-4">
        <button type="submit" class="btn-primary">Submit Project</button>
        <a href="/" class="btn-secondary">Cancel</a>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('post-form') as HTMLFormElement;
  const errorEl = document.getElementById('post-error') as HTMLDivElement;
  const successEl = document.getElementById('post-success') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      errorEl.textContent = 'You must be logged in to post a project. Please log in or create an account.';
      errorEl.classList.remove('hidden');
      return;
    }

    const formData = new FormData(form);

    const { error } = await supabase.from('projects').insert({
      title: formData.get('title'),
      category: formData.get('category'),
      project_type: formData.get('project_type'),
      description: formData.get('description'),
      location: formData.get('location'),
      budget_min: Number(formData.get('budget_min')) || null,
      budget_max: Number(formData.get('budget_max')) || null,
      timeline: formData.get('timeline') || null,
      start_date: formData.get('start_date') || null,
      user_id: user.id,
    });

    if (error) {
      errorEl.textContent = error.message;
      errorEl.classList.remove('hidden');
    } else {
      successEl.textContent = 'Project posted! Verified professionals will start sending you quotes soon.';
      successEl.classList.remove('hidden');
      form.reset();
    }
  });
</script>
